@model IEnumerable<GymWeb.Models.Registro>
@{
    var total      = Model.Count();
    var socios     = Model.Count(r => r.IdSocio != null);
    var visitasDia = Model.Count(r => r.IdSocio == null);
    var ingresos   = Model.Sum(r => r.PrecioVisita);
}

<div class="card">
    <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-clipboard-list"></i> Reporte de Visitas</div>
        <a asp-action="Index" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Reportes</a>
    </div>

    <!-- Filtro -->
    <form method="get" style="display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap;align-items:flex-end;">
        <div class="form-group">
            <label class="form-label">Desde</label>
            <input type="date" name="desde" class="form-control" value="@ViewBag.Desde" />
        </div>
        <div class="form-group">
            <label class="form-label">Hasta</label>
            <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-filter"></i> Filtrar</button>
    </form>

    <!-- Stats rápidos -->
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
        <div style="background:rgba(0,242,255,0.07);border:1px solid rgba(0,242,255,0.2);border-radius:10px;padding:12px 20px;min-width:130px;">
            <div style="font-size:11px;color:var(--text-muted);margin-bottom:2px;">Total visitas</div>
            <div style="font-size:22px;font-weight:700;color:var(--accent);">@total</div>
        </div>
        <div style="background:rgba(74,222,128,0.07);border:1px solid rgba(74,222,128,0.2);border-radius:10px;padding:12px 20px;min-width:130px;">
            <div style="font-size:11px;color:var(--text-muted);margin-bottom:2px;">Socios</div>
            <div style="font-size:22px;font-weight:700;color:#4ade80;">@socios</div>
        </div>
        <div style="background:rgba(251,191,36,0.07);border:1px solid rgba(251,191,36,0.2);border-radius:10px;padding:12px 20px;min-width:130px;">
            <div style="font-size:11px;color:var(--text-muted);margin-bottom:2px;">Visitas de día</div>
            <div style="font-size:22px;font-weight:700;color:#fbbf24;">@visitasDia</div>
        </div>
        <div style="background:rgba(167,139,250,0.07);border:1px solid rgba(167,139,250,0.2);border-radius:10px;padding:12px 20px;min-width:130px;">
            <div style="font-size:11px;color:var(--text-muted);margin-bottom:2px;">Ingresos visitas día</div>
            <div style="font-size:22px;font-weight:700;color:#a78bfa;">$@ingresos.ToString("N2")</div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="table-responsive">
        <table class="gym-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Nombre</th>
                    <th style="text-align:right;">Pago</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                var esSocio = v.IdSocio != null;
                var nombre  = esSocio
                    ? $"{v.IdSocioNavigation?.Paterno} {v.IdSocioNavigation?.Materno}, {v.IdSocioNavigation?.Nombre}".Trim().Trim(',')
                    : (v.NombreVisita ?? "Visitante");
                <tr>
                    <td class="text-muted" style="font-size:12px;">@v.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (esSocio)
                        {
                            <span style="font-size:11px;background:rgba(0,242,255,0.1);color:var(--accent);border-radius:20px;padding:2px 10px;">Socio</span>
                        }
                        else
                        {
                            <span style="font-size:11px;background:rgba(251,191,36,0.1);color:#fbbf24;border-radius:20px;padding:2px 10px;">Visita día</span>
                        }
                    </td>
                    <td><strong>@nombre</strong></td>
                    <td style="text-align:right;color:@(v.PrecioVisita > 0 ? "#4ade80" : "var(--text-muted)");font-weight:600;">
                        @(v.PrecioVisita > 0 ? "$" + v.PrecioVisita.ToString("N2") : "—")
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:40px;">Sin visitas en el periodo seleccionado.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
