@model IEnumerable<GymWeb.Models.Registro>
@{
    var socios   = ViewBag.Socios   as List<GymWeb.Models.Socio> ?? new();
    var socioSel = ViewBag.SocioSel as GymWeb.Models.Socio;
    int? idSocio = ViewBag.IdSocio;
    string desde = ViewBag.Desde ?? "";
    string hasta = ViewBag.Hasta ?? "";

    var dias = new[] { "Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado" };
    var porDia = Model
        .Where(r => r.FechaCreacion.HasValue)
        .GroupBy(r => (int)r.FechaCreacion!.Value.DayOfWeek)
        .ToDictionary(g => g.Key, g => g.Count());
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-chart-bar"></i> Asistencia por Socio</h1>
        <p class="page-subtitle">Consulta el historial de entradas de un socio en un período</p>
    </div>
</div>

<div style="margin-bottom:16px;">
    <a asp-action="Index" class="btn btn-outline btn-sm">
        <i class="fa-solid fa-arrow-left"></i> Volver a Reportes
    </a>
</div>

<style>
.sugerencia-socio-item:hover {
    background: rgba(0, 242, 100, 0.14) !important;
}
</style>

<div class="card" style="margin-bottom:20px;">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-filter"></i> Filtros</div></div>
    <form method="get" asp-action="Asistencia" id="formAsistencia" style="padding:16px 20px;">
        <div style="display:grid;grid-template-columns:1.5fr 1fr 1fr auto;gap:16px;align-items:end;">
            <div style="position:relative;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                    <label class="form-label" style="margin-bottom:0;font-weight:600;"><i class="fa-solid fa-user"></i> Socio</label>
                    <span id="contadorSociosFiltro" style="font-size:11.5px;color:var(--text-muted);">@socios.Count socios</span>
                </div>

                <!-- Buscador Rápido en Vivo por Clave o Nombre -->
                <div style="position:relative;margin-bottom:6px;">
                    <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#00f264;font-size:12px;pointer-events:none;"></i>
                    <input type="text" id="inputBuscarSocio" class="form-control"
                           style="padding-left:32px;padding-right:28px;height:36px;font-size:13px;border:1px solid rgba(0,242,100,0.35);background:rgba(0,0,0,0.25);"
                           placeholder="🔍 Escribe clave (ej. 1003) o nombre del socio..."
                           autocomplete="off" oninput="filtrarSociosLive(this.value)" onkeydown="manejarKeyBuscar(event)" />
                    <button type="button" onclick="limpiarBuscadorSocio()" id="btnLimpiarBuscar"
                            style="display:none;position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:13px;padding:2px 6px;" title="Limpiar búsqueda">✕</button>

                    <!-- Menú flotante de resultados rápidos -->
                    <div id="dropdownSugerenciasSocios" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;max-height:250px;overflow-y:auto;background:#111827;border:1px solid rgba(0,242,100,0.4);border-radius:8px;z-index:9999;box-shadow:0 12px 28px rgba(0,0,0,0.85);padding:4px 0;">
                    </div>
                </div>

                <select name="idSocio" class="form-control" id="socioSelect" style="height:38px;font-size:13px;" onchange="alCambiarSelectSocio()">
                    <option value="">— Seleccione un socio (@socios.Count) —</option>
                    @foreach (var s in socios)
                    {
                        bool isSel = (s.IdSocio == idSocio);
                        <option value="@s.IdSocio" data-clave="@s.IdSocio" data-nombre="@s.Nombre @s.Paterno @s.Materno" selected="@(isSel ? "selected" : null)">
                            #@s.IdSocio — @s.Nombre @s.Paterno @s.Materno
                        </option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Desde</label>
                <input type="date" name="desde" value="@desde" class="form-control" style="height:38px;" />
            </div>
            <div>
                <label class="form-label">Hasta</label>
                <input type="date" name="hasta" value="@hasta" class="form-control" style="height:38px;" />
            </div>
            <div>
                <button type="submit" class="btn btn-primary" style="width:100%;height:38px;display:flex;align-items:center;justify-content:center;gap:6px;">
                    <i class="fa-solid fa-magnifying-glass"></i> Consultar
                </button>
            </div>
        </div>
    </form>
</div>

@if (idSocio.HasValue)
{
    if (socioSel != null)
    {
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px;">
            <div class="card" style="padding:18px 20px;">
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px;">Socio</div>
                <div style="font-size:15px;font-weight:600;">@socioSel.Nombre @socioSel.Paterno</div>
                <div style="font-size:12px;color:var(--text-muted);">Clave #@socioSel.IdSocio</div>
            </div>
            <div class="card" style="padding:18px 20px;">
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px;">Total Visitas</div>
                <div style="font-size:26px;font-weight:700;color:var(--accent);">@Model.Count()</div>
            </div>
            <div class="card" style="padding:18px 20px;">
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px;">Período</div>
                <div style="font-size:14px;font-weight:600;">@desde.Replace("-","/") — @hasta.Replace("-","/")</div>
            </div>
            <div class="card" style="padding:18px 20px;">
                <div style="font-size:12px;color:var(--text-muted);margin-bottom:6px;">Día más frecuente</div>
                @if (porDia.Any())
                {
                    var maxDia = porDia.OrderByDescending(x => x.Value).First();
                    <div style="font-size:15px;font-weight:600;">@dias[maxDia.Key]</div>
                    <div style="font-size:12px;color:var(--text-muted);">@maxDia.Value visita(s)</div>
                }
                else
                {
                    <div class="text-muted" style="font-size:13px;">—</div>
                }
            </div>
        </div>

        @if (porDia.Any())
        {
            <div class="card" style="margin-bottom:20px;">
                <div class="card-header"><div class="card-title"><i class="fa-solid fa-calendar-week"></i> Distribución por Día</div></div>
                <div style="padding:16px 20px;display:flex;gap:10px;flex-wrap:wrap;">
                @for (int d = 0; d < 7; d++)
                {
                    var cnt = porDia.ContainsKey(d) ? porDia[d] : 0;
                    var max = porDia.Any() ? porDia.Values.Max() : 1;
                    var pct = max > 0 ? (cnt * 100 / max) : 0;
                    <div style="flex:1;min-width:70px;text-align:center;">
                        <div style="font-size:11px;color:var(--text-muted);margin-bottom:6px;">@dias[d]</div>
                        <div style="background:var(--bg-tertiary);border-radius:6px;height:80px;display:flex;align-items:flex-end;justify-content:center;overflow:hidden;">
                            <div style="width:100%;background:var(--accent);opacity:0.85;height:@(pct)%;min-height:@(cnt>0?"4px":"0");transition:height 0.3s;"></div>
                        </div>
                        <div style="font-size:16px;font-weight:700;margin-top:6px;">@cnt</div>
                    </div>
                }
                </div>
            </div>
        }
    }

    @if (!Model.Any())
    {
        <div class="card" style="padding:32px;text-align:center;">
            <div style="font-size:40px;color:var(--text-muted);margin-bottom:12px;"><i class="fa-solid fa-calendar-xmark"></i></div>
            <p class="text-muted">No hay registros de asistencia en el período seleccionado.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title"><i class="fa-solid fa-list"></i> Registro de Entradas (@Model.Count())</div>
            </div>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Fecha y Hora</th>
                            <th>Día</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ int n = Model.Count(); }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@n--</td>
                            <td>
                                @if (r.FechaCreacion.HasValue)
                                {
                                    <span style="font-weight:500;">@r.FechaCreacion.Value.ToString("dd/MM/yyyy")</span>
                                    <span class="text-muted" style="font-size:12px;margin-left:8px;">@r.FechaCreacion.Value.ToString("HH:mm")</span>
                                }
                            </td>
                            <td>
                                @if (r.FechaCreacion.HasValue)
                                {
                                    <span class="badge badge-info">@dias[(int)r.FechaCreacion.Value.DayOfWeek]</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <div class="card" style="padding:32px;text-align:center;">
        <div style="font-size:40px;color:var(--text-muted);margin-bottom:12px;"><i class="fa-solid fa-user-magnifying-glass"></i></div>
        <p class="text-muted">Selecciona un socio y un rango de fechas para ver su historial de asistencia.</p>
    </div>
}

@section Scripts {
<script>
let catalogoSocios = [];
let itemSugerenciaActivo = -1;

function normalizarTexto(txt) {
    return (txt || '').toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
}

document.addEventListener('DOMContentLoaded', function() {
    const sel = document.getElementById('socioSelect');
    const input = document.getElementById('inputBuscarSocio');
    const btnLimpiar = document.getElementById('btnLimpiarBuscar');

    // Inicializar catálogo en memoria
    if (sel) {
        catalogoSocios = Array.from(sel.options).filter(o => o.value !== "").map(o => ({
            value: o.value,
            clave: o.getAttribute('data-clave') || o.value,
            nombre: o.getAttribute('data-nombre') || o.text,
            texto: o.text,
            claveNorm: normalizarTexto(o.getAttribute('data-clave') || o.value),
            nombreNorm: normalizarTexto(o.getAttribute('data-nombre') || o.text),
            fullNorm: normalizarTexto(o.text)
        }));

        // Si ya hay un socio seleccionado, mostrar su nombre en el input de búsqueda
        if (sel.value) {
            const socioActual = catalogoSocios.find(s => s.value === sel.value);
            if (socioActual) {
                input.value = socioActual.texto;
                btnLimpiar.style.display = 'block';
            }
        }
    }

    // Cerrar sugerencias al hacer clic fuera
    document.addEventListener('click', function(e) {
        const wrap = document.getElementById('dropdownSugerenciasSocios');
        const inputB = document.getElementById('inputBuscarSocio');
        if (wrap && !wrap.contains(e.target) && e.target !== inputB) {
            wrap.style.display = 'none';
        }
    });
});

function filtrarSociosLive(val) {
    const term = normalizarTexto(val);
    const sel = document.getElementById('socioSelect');
    const dropdown = document.getElementById('dropdownSugerenciasSocios');
    const btnLimpiar = document.getElementById('btnLimpiarBuscar');
    const contador = document.getElementById('contadorSociosFiltro');

    itemSugerenciaActivo = -1;

    if (!term) {
        btnLimpiar.style.display = 'none';
        dropdown.style.display = 'none';
        dropdown.innerHTML = '';
        contador.textContent = `${catalogoSocios.length} socios`;
        restaurarSelect(sel, catalogoSocios, sel.value);
        return;
    }

    btnLimpiar.style.display = 'block';

    // Coincidencias: prioridad si la clave inicia con el término o contiene el nombre
    const matches = catalogoSocios.filter(s => {
        return s.claveNorm.includes(term) || s.nombreNorm.includes(term) || s.fullNorm.includes(term);
    });

    contador.textContent = `${matches.length} encontrado(s)`;

    // Actualizar select nativo con sólo las coincidencias
    restaurarSelect(sel, matches, matches.length === 1 ? matches[0].value : (sel.value || (matches[0] ? matches[0].value : '')));

    // Renderizar dropdown flotante
    if (matches.length === 0) {
        dropdown.innerHTML = `<div style="padding:10px 14px;color:var(--text-muted);font-size:12px;text-align:center;"><i class="fa-solid fa-circle-exclamation"></i> No se encontró ningún socio con "${val}"</div>`;
        dropdown.style.display = 'block';
    } else {
        dropdown.innerHTML = matches.slice(0, 12).map((s, idx) => `
            <div class="sugerencia-socio-item" data-index="${idx}" data-val="${s.value}"
                 onclick="seleccionarSugerencia('${s.value}', '${s.texto.replace(/'/g, "\\'")}')"
                 style="padding:8px 14px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.05);transition:background 0.15s ease;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <span style="background:rgba(0,242,100,0.12);color:#00f264;border:1px solid rgba(0,242,100,0.3);font-family:'Inter',monospace;padding:2px 7px;border-radius:4px;font-size:11px;font-weight:700;">#${s.clave}</span>
                    <span style="font-weight:600;font-size:13px;color:#f8fafc;">${s.nombre}</span>
                </div>
                <span style="font-size:11px;color:var(--text-muted);"><i class="fa-solid fa-arrow-turn-down"></i> Seleccionar</span>
            </div>
        `).join('');
        dropdown.style.display = 'block';
    }
}

function restaurarSelect(sel, lista, selectedValue) {
    sel.innerHTML = `<option value="">— Seleccione un socio (${lista.length}) —</option>`;
    lista.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.value;
        opt.textContent = s.texto;
        opt.setAttribute('data-clave', s.clave);
        opt.setAttribute('data-nombre', s.nombre);
        if (s.value === selectedValue) {
            opt.selected = true;
        }
        sel.appendChild(opt);
    });
}

function seleccionarSugerencia(id, textoCompleto) {
    const sel = document.getElementById('socioSelect');
    const input = document.getElementById('inputBuscarSocio');
    const dropdown = document.getElementById('dropdownSugerenciasSocios');
    const btnLimpiar = document.getElementById('btnLimpiarBuscar');

    // Restaurar select con todos los socios y seleccionar el elegido
    restaurarSelect(sel, catalogoSocios, id);
    sel.value = id;

    input.value = textoCompleto;
    btnLimpiar.style.display = 'block';
    dropdown.style.display = 'none';
    document.getElementById('contadorSociosFiltro').textContent = `${catalogoSocios.length} socios`;
}

function alCambiarSelectSocio() {
    const sel = document.getElementById('socioSelect');
    const input = document.getElementById('inputBuscarSocio');
    const btnLimpiar = document.getElementById('btnLimpiarBuscar');

    if (sel.value) {
        const socio = catalogoSocios.find(s => s.value === sel.value);
        if (socio) {
            input.value = socio.texto;
            btnLimpiar.style.display = 'block';
        }
    } else {
        input.value = '';
        btnLimpiar.style.display = 'none';
    }
}

function limpiarBuscadorSocio() {
    const sel = document.getElementById('socioSelect');
    const input = document.getElementById('inputBuscarSocio');
    const btnLimpiar = document.getElementById('btnLimpiarBuscar');
    const dropdown = document.getElementById('dropdownSugerenciasSocios');

    input.value = '';
    btnLimpiar.style.display = 'none';
    dropdown.style.display = 'none';
    restaurarSelect(sel, catalogoSocios, '');
    sel.value = '';
    document.getElementById('contadorSociosFiltro').textContent = `${catalogoSocios.length} socios`;
    input.focus();
}

function manejarKeyBuscar(e) {
    const dropdown = document.getElementById('dropdownSugerenciasSocios');
    const items = dropdown.querySelectorAll('.sugerencia-socio-item');

    if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length > 0) {
            itemSugerenciaActivo = (itemSugerenciaActivo + 1) % items.length;
            resaltarItemSugerencia(items);
        }
    } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length > 0) {
            itemSugerenciaActivo = (itemSugerenciaActivo - 1 + items.length) % items.length;
            resaltarItemSugerencia(items);
        }
    } else if (e.key === 'Enter') {
        if (itemSugerenciaActivo >= 0 && items[itemSugerenciaActivo]) {
            e.preventDefault();
            items[itemSugerenciaActivo].click();
        } else {
            // Si el select tiene valor, enviar formulario directamente
            const sel = document.getElementById('socioSelect');
            if (sel.value) {
                document.getElementById('formAsistencia').submit();
            }
        }
    } else if (e.key === 'Escape') {
        dropdown.style.display = 'none';
    }
}

function resaltarItemSugerencia(items) {
    items.forEach((it, idx) => {
        if (idx === itemSugerenciaActivo) {
            it.style.background = 'rgba(0,242,100,0.18)';
            it.scrollIntoView({ block: 'nearest' });
        } else {
            it.style.background = 'transparent';
        }
    });
}
</script>
}
