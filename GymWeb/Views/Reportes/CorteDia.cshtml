@using GymWeb.Models
@{
    string fecha         = ViewBag.Fecha;
    string fechaDisplay  = ViewBag.FechaDisplay;
    var ventas           = (List<Detallesalidum>)ViewBag.Ventas;
    var visitas          = (List<Registro>)ViewBag.Visitas;
    var pagos            = (List<Pago>)ViewBag.Pagos;
    decimal precioConfig = (decimal)ViewBag.PrecioConfig;
    string modo          = ViewBag.Modo  ?? "dia";
    string mes           = ViewBag.Mes   ?? DateTime.Today.ToString("yyyy-MM");

    var ventasContado   = ventas.Where(v => v.IdSalidaNavigation?.EsCredito != true).ToList();
    var ventasCredito   = ventas.Where(v => v.IdSalidaNavigation?.EsCredito == true).ToList();

    decimal totalVentasContado = ventasContado.Sum(v => (v.PrecioUnitario ?? 0) * v.Cantidad);
    decimal totalVentasCredito = ventasCredito.Sum(v => (v.PrecioUnitario ?? 0) * v.Cantidad);
    int totalUnidadesVentas = ventas.Sum(v => v.Cantidad);
    decimal totalVisitas = visitas.Sum(r => r.PrecioVisita);

    // ── AUDITORÍA CONTABLE: Clasificación de Cobranza (Membresías vs Abonos a Deuda) ──
    var abonosCredito  = pagos.Where(p => p.IdMembresia == null && (p.Notas != null && p.Notas.StartsWith("Abono"))).ToList();
    var pagosMembresia = pagos.Where(p => !abonosCredito.Contains(p)).ToList();

    decimal totalMembresias = pagosMembresia.Sum(p => p.Monto);
    decimal totalAbonos     = abonosCredito.Sum(p => p.Monto);
    decimal totalPagos      = pagos.Sum(p => p.Monto); // Membresías + Abonos

    // ── AUDITORÍA DE MÁRGENES / GANANCIA EN PRODUCTOS ──
    decimal gananciaContado = ventasContado.Sum(v => ((v.PrecioUnitario ?? 0) - (v.IdProductoNavigation?.Costo ?? 0)) * v.Cantidad);
    decimal gananciaCredito = ventasCredito.Sum(v => ((v.PrecioUnitario ?? 0) - (v.IdProductoNavigation?.Costo ?? 0)) * v.Cantidad);

    // ── TOTAL EN CAJA REAL (FLUJO DE EFECTIVO INGRESADO FÍSICAMENTE HOY) ──
    decimal totalDia = totalVentasContado + totalVisitas + totalPagos;
    int visitasSinPrecio = visitas.Count(r => r.PrecioVisita == 0);

    // ── CONCILIACIÓN POR MÉTODO DE PAGO (ARQUEO DE CAJA FÍSICA Y BANCOS) ──
    decimal efectivoVisitas = totalVisitas; // Visitas de mostrador ingresan en efectivo
    decimal efectivoVentas  = ventasContado.Where(v => string.Equals(v.IdSalidaNavigation?.MetodoPago, "Efectivo", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(v.IdSalidaNavigation?.MetodoPago)).Sum(v => (v.PrecioUnitario ?? 0) * v.Cantidad);
    decimal efectivoPagos   = pagos.Where(p => string.Equals(p.MetodoPago, "Efectivo", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(p.MetodoPago)).Sum(p => p.Monto);
    decimal totalEfectivo   = efectivoVisitas + efectivoVentas + efectivoPagos;

    decimal tarjetaVentas   = ventasContado.Where(v => string.Equals(v.IdSalidaNavigation?.MetodoPago, "Tarjeta", StringComparison.OrdinalIgnoreCase)).Sum(v => (v.PrecioUnitario ?? 0) * v.Cantidad);
    decimal tarjetaPagos    = pagos.Where(p => string.Equals(p.MetodoPago, "Tarjeta", StringComparison.OrdinalIgnoreCase)).Sum(p => p.Monto);
    decimal totalTarjeta    = tarjetaVentas + tarjetaPagos;

    decimal transferVentas  = ventasContado.Where(v => string.Equals(v.IdSalidaNavigation?.MetodoPago, "Transferencia", StringComparison.OrdinalIgnoreCase)).Sum(v => (v.PrecioUnitario ?? 0) * v.Cantidad);
    decimal transferPagos   = pagos.Where(p => string.Equals(p.MetodoPago, "Transferencia", StringComparison.OrdinalIgnoreCase)).Sum(p => p.Monto);
    decimal totalTransfer   = transferVentas + transferPagos;
}

<div class="card" style="max-width:820px;">
    <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-cash-register"></i> Corte @(modo=="mes"?"del Mes":"del Día") — @fechaDisplay</div>
        <div style="display:flex;gap:8px;">
            <a href="/Reportes/ExportarCorte?modo=@modo&fecha=@fecha&mes=@mes&formato=excel" class="btn btn-sm" style="background:#16a34a;color:#fff;" title="Descargar reporte formal en Excel con Logo"><i class="fa-solid fa-file-excel"></i> Excel</a>
            <a asp-action="Index" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Reportes</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-info"></i> @TempData["Info"]</div>
    }

    @* ── Advertencia si hay visitas sin precio ── *@
    @if (modo == "dia" && visitasSinPrecio > 0)
    {
        <div style="background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.35);border-radius:var(--radius);padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <i class="fa-solid fa-triangle-exclamation" style="color:#fbbf24;font-size:20px;flex-shrink:0;"></i>
            <div style="flex:1;">
                <strong style="color:#fbbf24;">@visitasSinPrecio visita(s) sin precio asignado</strong>
                @if (precioConfig > 0)
                {
                    <div class="text-muted" style="font-size:12px;">Precio configurado: <strong style="color:#4ade80;">$@precioConfig.ToString("N2")</strong> — Haz clic en "Aplicar" para corregirlas</div>
                }
                else
                {
                    <div class="text-muted" style="font-size:12px;">Ve a <a asp-controller="Configuracion" asp-action="Index" style="color:var(--accent);">Configuración</a> y establece el precio de visita de día primero.</div>
                }
            </div>
            @if (precioConfig > 0)
            {
                <form asp-action="AplicarPrecio" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fecha" value="@fecha" />
                    <input type="hidden" name="precio" value="@precioConfig.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                    <button type="submit" class="btn btn-sm" style="background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.4);color:#fbbf24;white-space:nowrap;">
                        <i class="fa-solid fa-rotate"></i> Aplicar $@precioConfig.ToString("N2") a @visitasSinPrecio visita(s)
                    </button>
                </form>
            }
        </div>
    }

    @* ── Selector de fecha / mes ── *@
    <form method="get" style="margin-bottom:24px;">
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            <button type="button" onclick="setModo('dia')"
                style="padding:5px 14px;border-radius:8px;border:1px solid @(modo=="dia"?"var(--accent)":"var(--border)");background:@(modo=="dia"?"rgba(0,242,255,0.12)":"transparent");color:@(modo=="dia"?"var(--accent)":"var(--text-muted)");font-size:12px;cursor:pointer;">
                <i class="fa-solid fa-calendar-day"></i> Por día
            </button>
            <button type="button" onclick="setModo('mes')"
                style="padding:5px 14px;border-radius:8px;border:1px solid @(modo=="mes"?"var(--accent)":"var(--border)");background:@(modo=="mes"?"rgba(0,242,255,0.12)":"transparent");color:@(modo=="mes"?"var(--accent)":"var(--text-muted)");font-size:12px;cursor:pointer;">
                <i class="fa-solid fa-calendar-month"></i> Por mes
            </button>
        </div>
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
            <div id="wrapDia" class="form-group" style="margin:0;@(modo=="mes"?"display:none;":"")">
                <label class="form-label">Fecha</label>
                <input type="date" name="fecha" class="form-control" value="@fecha" />
            </div>
            <div id="wrapMes" class="form-group" style="margin:0;@(modo=="dia"?"display:none;":"")">
                <label class="form-label">Mes</label>
                <input type="month" name="mes" class="form-control" value="@mes" />
            </div>
            <input type="hidden" name="modo" id="hidModo" value="@modo" />
            <button type="submit" class="btn btn-primary btn-sm" style="align-self:flex-end;">
                <i class="fa-solid fa-filter"></i> Ver corte
            </button>
        </div>
    </form>

    @* ── Resumen en tarjetas ejecutivas ── *@
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:28px;">
        <div style="background:rgba(167,139,250,0.08);border:1px solid rgba(167,139,250,0.25);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Visitas de día</div>
            <div style="font-size:22px;font-weight:700;color:#a78bfa;margin-top:4px;">@visitas.Count</div>
            <div style="font-size:13px;color:#a78bfa;margin-top:2px;">$@totalVisitas.ToString("N2")</div>
        </div>
        <div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Ventas en caja</div>
            <div style="font-size:22px;font-weight:700;color:#10b981;margin-top:4px;">@totalUnidadesVentas <span style="font-size:12px;font-weight:400;color:var(--text-muted);">unid.</span></div>
            <div style="font-size:13px;color:#10b981;margin-top:2px;">$@totalVentasContado.ToString("N2")</div>
            @if (totalVentasCredito > 0)
            {
                <div style="font-size:11px;color:#fb923c;margin-top:4px;" title="Ventas a crédito: no suman a caja hasta su cobro físico">
                    <i class="fa-solid fa-clock"></i> A Crédito: $@totalVentasCredito.ToString("N2") (por cobrar)
                </div>
            }
        </div>
        <div style="background:rgba(56,189,248,0.08);border:1px solid rgba(56,189,248,0.25);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Cobranza Membresías / Abonos</div>
            <div style="font-size:22px;font-weight:700;color:#38bdf8;margin-top:4px;">@pagos.Count <span style="font-size:12px;font-weight:400;color:var(--text-muted);">recibos</span></div>
            <div style="font-size:13px;color:#38bdf8;margin-top:2px;">$@totalPagos.ToString("N2")</div>
            @if (totalAbonos > 0)
            {
                <div style="font-size:11px;color:#fbbf24;margin-top:4px;" title="Abonos a deudas de crédito cobrados e ingresados a caja">
                    <i class="fa-solid fa-hand-holding-dollar"></i> Abonos: $@totalAbonos.ToString("N2")
                </div>
            }
        </div>
        <div style="background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.3);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">@(modo=="mes"?"Total del mes":"Total en caja")</div>
            <div style="font-size:26px;font-weight:800;color:#4ade80;margin-top:4px;">$@totalDia.ToString("N2")</div>
            <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Ingreso real verificado</div>
        </div>
    </div>

    @* ── Visitas de día ── *@
    @if (visitas.Any())
    {
        <div style="margin-bottom:28px;">
            <h3 style="font-size:14px;font-weight:600;color:#a78bfa;margin-bottom:10px;display:flex;align-items:center;gap:8px;">
                <i class="fa-solid fa-person-walking-arrow-right"></i> Visitas de día (@visitas.Count)
            </h3>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Visitante</th>
                            <th style="text-align:right;">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in visitas)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@(modo=="mes" ? v.FechaCreacion?.ToString("dd/MM HH:mm") : v.FechaCreacion?.ToString("HH:mm"))</td>
                            <td class="name-cell">@v.NombreVisita</td>
                            <td style="text-align:right;color:#a78bfa;font-weight:600;">$@v.PrecioVisita.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="background:rgba(167,139,250,0.07);font-weight:700;">
                            <td colspan="2" style="text-align:right;font-size:13px;color:var(--text-muted);">Subtotal visitas</td>
                            <td style="text-align:right;color:#a78bfa;">$@totalVisitas.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="margin-bottom:28px;padding:14px;background:rgba(167,139,250,0.04);border:1px solid rgba(167,139,250,0.15);border-radius:var(--radius);color:var(--text-muted);font-size:13px;">
            <i class="fa-solid fa-person-walking-arrow-right"></i> Sin visitas de día registradas
        </div>
    }

    @* ── Ventas de productos ── *@
    @if (ventas.Any())
    {
        <div style="margin-bottom:24px;">
            <h3 style="font-size:14px;font-weight:600;color:#10b981;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
                <span><i class="fa-solid fa-bag-shopping"></i> Ventas de productos (@totalUnidadesVentas @(totalUnidadesVentas == 1 ? "unidad" : "unidades"))</span>
                <span style="font-size:12px;font-weight:normal;color:var(--text-muted);">Contado: $@totalVentasContado.ToString("N2") @(totalVentasCredito > 0 ? $"· A Crédito: ${totalVentasCredito:N2}" : "")</span>
            </h3>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Producto</th>
                            <th style="text-align:right;">Cant.</th>
                            <th style="text-align:right;">Total</th>
                            <th style="text-align:right;">Ganancia</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in ventas)
                    {
                        bool esCredito = v.IdSalidaNavigation?.EsCredito == true;
                        string metodoVenta = v.IdSalidaNavigation?.MetodoPago?.Trim() ?? "Efectivo";
                        decimal costoItem = v.IdProductoNavigation?.Costo ?? 0m;
                        decimal precioItem = v.PrecioUnitario ?? 0m;
                        decimal gananciaItem = (precioItem - costoItem) * v.Cantidad;
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@(modo=="mes" ? v.IdSalidaNavigation?.FechaCreacion?.ToString("dd/MM HH:mm") : v.IdSalidaNavigation?.FechaCreacion?.ToString("HH:mm"))</td>
                            <td class="name-cell">
                                @v.IdProductoNavigation?.Nombre
                                @if (esCredito)
                                {
                                    <span class="badge" style="font-size:10px;background:rgba(251,146,60,0.15);color:#fb923c;border:1px solid rgba(251,146,60,0.3);margin-left:6px;" title="Venta a crédito: no suma a caja hoy">
                                        <i class="fa-solid fa-clock"></i> A Crédito
                                    </span>
                                }
                                else if (string.Equals(metodoVenta, "Transferencia", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge" style="font-size:10px;background:rgba(56,189,248,0.15);color:#38bdf8;border:1px solid rgba(56,189,248,0.35);margin-left:6px;" title="Cobrado por Transferencia SPEI / Bancos">
                                        <i class="fa-solid fa-building-columns"></i> Transferencia
                                    </span>
                                }
                                else if (string.Equals(metodoVenta, "Tarjeta", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge" style="font-size:10px;background:rgba(167,139,250,0.15);color:#a78bfa;border:1px solid rgba(167,139,250,0.35);margin-left:6px;" title="Cobrado en Terminal de Tarjetas">
                                        <i class="fa-solid fa-credit-card"></i> Tarjeta
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="font-size:10px;background:rgba(74,222,128,0.12);color:#4ade80;border:1px solid rgba(74,222,128,0.25);margin-left:6px;" title="Cobrado en Efectivo">
                                        <i class="fa-solid fa-money-bill-wave"></i> Efectivo
                                    </span>
                                }
                            </td>
                            <td style="text-align:right;color:var(--text-muted);">@v.Cantidad</td>
                            <td style="text-align:right;color:#4ade80;font-weight:600;">$@((precioItem * v.Cantidad).ToString("N2"))</td>
                            <td style="text-align:right;font-size:12px;color:#4ade80;">
                                $@gananciaItem.ToString("N2")
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="background:rgba(16,185,129,0.07);font-weight:700;">
                            <td colspan="3" style="text-align:right;font-size:13px;color:var(--text-muted);">Subtotal Contado (en caja):</td>
                            <td style="text-align:right;color:#4ade80;">$@totalVentasContado.ToString("N2")</td>
                            <td style="text-align:right;color:#4ade80;font-size:12px;" title="Ganancia realizada cobrada en caja">$@gananciaContado.ToString("N2")</td>
                        </tr>
                        @if (totalVentasCredito > 0)
                        {
                            <tr style="background:rgba(251,146,60,0.04);font-size:12px;">
                                <td colspan="3" style="text-align:right;color:#fb923c;">
                                    <i class="fa-solid fa-clock"></i> Ventas a Crédito (No ingresan a caja de hoy):
                                </td>
                                <td style="text-align:right;color:#fb923c;font-weight:700;">$@totalVentasCredito.ToString("N2")</td>
                                <td style="text-align:right;color:#fb923c;font-size:11px;" title="Ganancia pendiente de cobro en efectivo">$@gananciaCredito.ToString("N2") <span style="font-size:9.5px;">(por cobrar)</span></td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="margin-bottom:24px;padding:14px;background:rgba(251,146,60,0.04);border:1px solid rgba(251,146,60,0.15);border-radius:var(--radius);color:var(--text-muted);font-size:13px;">
            <i class="fa-solid fa-bag-shopping"></i> Sin ventas de productos en este día
        </div>
    }

    @* ── Pagos de membresías y cobranza de abonos ── *@
    @if (pagos.Any())
    {
        <div style="margin-bottom:28px;">
            <h3 style="font-size:14px;font-weight:600;color:#38bdf8;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
                <span><i class="fa-solid fa-receipt"></i> Pagos y Cobranza Recibida (@pagos.Count)</span>
                <span style="font-size:12px;font-weight:normal;color:var(--text-muted);">Membresías: $@totalMembresias.ToString("N2") @(totalAbonos > 0 ? $"· Abonos de Crédito: ${totalAbonos:N2}" : "")</span>
            </h3>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Socio</th>
                            <th>Concepto / Plan</th>
                            <th>Método</th>
                            <th style="text-align:right;">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in pagos)
                    {
                        bool esAbono = p.IdMembresia == null && (p.Notas != null && p.Notas.StartsWith("Abono"));
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@(modo=="mes" ? p.FechaCreacion?.ToString("dd/MM HH:mm") : p.FechaCreacion?.ToString("HH:mm"))</td>
                            <td class="name-cell">
                                @if (p.IdSocioNavigation != null)
                                {
                                    <span>@p.IdSocioNavigation.Nombre @p.IdSocioNavigation.Paterno</span>
                                    <span class="text-muted" style="font-size:11px;margin-left:5px;">#@p.IdSocio</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>
                                @if (p.IdMembresiaNavigation != null)
                                {
                                    <span class="badge badge-info"><i class="fa-solid fa-id-card"></i> @p.IdMembresiaNavigation.Nombre</span>
                                }
                                else if (esAbono)
                                {
                                    <span class="badge" style="background:rgba(245,158,11,0.15);color:#fbbf24;border:1px solid rgba(245,158,11,0.35);font-size:11px;" title="@p.Notas">
                                        <i class="fa-solid fa-hand-holding-dollar"></i> @(string.IsNullOrWhiteSpace(p.Notas) ? "Abono a Crédito" : p.Notas)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(148,163,184,0.15);color:#cbd5e1;font-size:11px;">
                                        @(string.IsNullOrWhiteSpace(p.Notas) ? "Cobro General" : p.Notas)
                                    </span>
                                }
                            </td>
                            <td style="font-size:13px;">
                                @if (string.Equals(p.MetodoPago, "Transferencia", StringComparison.OrdinalIgnoreCase))
                                { <span style="color:#38bdf8;"><i class="fa-solid fa-building-columns"></i> Transferencia</span> }
                                else if (string.Equals(p.MetodoPago, "Tarjeta", StringComparison.OrdinalIgnoreCase))
                                { <span style="color:#a78bfa;"><i class="fa-solid fa-credit-card"></i> Tarjeta</span> }
                                else
                                { <span style="color:#4ade80;"><i class="fa-solid fa-money-bill-wave"></i> Efectivo</span> }
                            </td>
                            <td style="text-align:right;color:#38bdf8;font-weight:600;">$@p.Monto.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="background:rgba(56,189,248,0.07);font-weight:700;">
                            <td colspan="4" style="text-align:right;font-size:13px;color:var(--text-muted);">Subtotal Cobranza (Membresías + Abonos):</td>
                            <td style="text-align:right;color:#38bdf8;">$@totalPagos.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="margin-bottom:28px;padding:14px;background:rgba(56,189,248,0.04);border:1px solid rgba(56,189,248,0.15);border-radius:var(--radius);color:var(--text-muted);font-size:13px;">
            <i class="fa-solid fa-id-card"></i> Sin pagos ni cobranza registrados en este período
        </div>
    }

    @* ── Panel de Arqueo y Conciliación de Caja (Auditoría Contable) ── *@
    <div style="background:rgba(15,23,42,0.6);border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;margin-bottom:24px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;border-bottom:1px solid rgba(255,255,255,0.08);padding-bottom:10px;">
            <div style="font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#38bdf8;display:flex;align-items:center;gap:8px;">
                <i class="fa-solid fa-scale-balanced"></i> Conciliación y Arqueo de Caja (Auditoría Contable)
            </div>
            <span class="badge" style="background:rgba(74,222,128,0.15);color:#4ade80;border:1px solid rgba(74,222,128,0.35);font-size:11px;font-weight:700;">
                <i class="fa-solid fa-circle-check"></i> Cuadratura Exacta 100%
            </span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:14px;">
            <div style="background:rgba(74,222,128,0.06);border:1px solid rgba(74,222,128,0.25);border-radius:10px;padding:12px 14px;">
                <div style="font-size:11px;color:#4ade80;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">
                    <i class="fa-solid fa-money-bill-wave"></i> Efectivo Físico en Caja
                </div>
                <div style="font-size:22px;font-weight:800;color:#4ade80;margin-top:4px;">$@totalEfectivo.ToString("N2")</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Dinero físico en cajón</div>
            </div>

            <div style="background:rgba(56,189,248,0.06);border:1px solid rgba(56,189,248,0.25);border-radius:10px;padding:12px 14px;">
                <div style="font-size:11px;color:#38bdf8;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">
                    <i class="fa-solid fa-building-columns"></i> Transferencias SPEI / Bancos
                </div>
                <div style="font-size:22px;font-weight:800;color:#38bdf8;margin-top:4px;">$@totalTransfer.ToString("N2")</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Comprobantes en banca móvil</div>
            </div>

            <div style="background:rgba(167,139,250,0.06);border:1px solid rgba(167,139,250,0.25);border-radius:10px;padding:12px 14px;">
                <div style="font-size:11px;color:#a78bfa;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">
                    <i class="fa-solid fa-credit-card"></i> Terminal Tarjetas / POS
                </div>
                <div style="font-size:22px;font-weight:800;color:#a78bfa;margin-top:4px;">$@totalTarjeta.ToString("N2")</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Vouchers en terminal</div>
            </div>
        </div>

        @if (totalVentasCredito > 0 || totalAbonos > 0)
        {
            <div style="margin-top:14px;padding-top:12px;border-top:1px dashed rgba(255,255,255,0.08);display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:12px;">
                <div style="color:#fb923c;">
                    <i class="fa-solid fa-clock"></i> <strong>Cuentas por cobrar generadas hoy:</strong> $@totalVentasCredito.ToString("N2") (no ingresan a caja hasta su cobro)
                </div>
                @if (totalAbonos > 0)
                {
                    <div style="color:#4ade80;">
                        <i class="fa-solid fa-hand-holding-dollar"></i> <strong>Abonos de crédito cobrados hoy:</strong> $@totalAbonos.ToString("N2") (ingresados a caja hoy)
                    </div>
                }
            </div>
        }
    </div>

    @* ── Total final ── *@
    <div style="border-top:1px solid var(--border);padding-top:16px;display:flex;justify-content:flex-end;">
        <div style="background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.3);border-radius:var(--radius);padding:14px 26px;text-align:right;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Total @(modo=="mes"?"del mes de":"generado el") @fechaDisplay</div>
            <div style="font-size:32px;font-weight:800;color:#4ade80;margin-top:4px;">$@totalDia.ToString("N2")</div>
            @if (totalDia > 0)
            {
                <div class="text-muted" style="font-size:11.5px;margin-top:4px;">
                    Visitas $@totalVisitas.ToString("N2") + Ventas contado $@totalVentasContado.ToString("N2") + Membresías $@totalMembresias.ToString("N2") @(totalAbonos > 0 ? $"+ Abonos ${totalAbonos:N2}" : "")
                </div>
            }
        </div>
    </div>
</div>

<script>
function setModo(v) {
    document.getElementById('hidModo').value = v;
    document.getElementById('wrapDia').style.display = v === 'dia' ? '' : 'none';
    document.getElementById('wrapMes').style.display = v === 'mes' ? '' : 'none';
}
</script>
