@using GymWeb.Models
@{
    string fecha         = ViewBag.Fecha;
    string fechaDisplay  = ViewBag.FechaDisplay;
    var ventas           = (List<Detallesalidum>)ViewBag.Ventas;
    var visitas          = (List<Registro>)ViewBag.Visitas;
    var pagos            = (List<Pago>)ViewBag.Pagos;
    decimal precioConfig = (decimal)ViewBag.PrecioConfig;
    string modo          = ViewBag.Modo  ?? "dia";
    string mes           = ViewBag.Mes   ?? DateTime.Today.ToString("yyyy-MM");

    decimal totalVentas  = ventas.Sum(v => (v.PrecioUnitario ?? 0) * v.Cantidad);
    int totalUnidadesVentas = ventas.Sum(v => v.Cantidad);
    decimal totalVisitas = visitas.Sum(r => r.PrecioVisita);
    decimal totalPagos   = pagos.Sum(p => p.Monto);
    decimal totalDia     = totalVentas + totalVisitas + totalPagos;
    int visitasSinPrecio = visitas.Count(r => r.PrecioVisita == 0);
}

<div class="card" style="max-width:760px;">
    <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-cash-register"></i> Corte @(modo=="mes"?"del Mes":"del Día") — @fechaDisplay</div>
        <div style="display:flex;gap:8px;">
            <a href="/Reportes/ExportarCorte?modo=@modo&fecha=@fecha&mes=@mes&formato=excel" class="btn btn-sm" style="background:#16a34a;color:#fff;" title="Descargar reporte formal en Excel con Logo"><i class="fa-solid fa-file-excel"></i> Excel</a>
            <a asp-action="Index" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Reportes</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-info"></i> @TempData["Info"]</div>
    }

    @* ── Advertencia si hay visitas sin precio ── *@
    @if (modo == "dia" && visitasSinPrecio > 0)
    {
        <div style="background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.35);border-radius:var(--radius);padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <i class="fa-solid fa-triangle-exclamation" style="color:#fbbf24;font-size:20px;flex-shrink:0;"></i>
            <div style="flex:1;">
                <strong style="color:#fbbf24;">@visitasSinPrecio visita(s) sin precio asignado</strong>
                @if (precioConfig > 0)
                {
                    <div class="text-muted" style="font-size:12px;">Precio configurado: <strong style="color:#4ade80;">$@precioConfig.ToString("N2")</strong> — Haz clic en "Aplicar" para corregirlas</div>
                }
                else
                {
                    <div class="text-muted" style="font-size:12px;">Ve a <a asp-controller="Configuracion" asp-action="Index" style="color:var(--accent);">Configuración</a> y establece el precio de visita de día primero.</div>
                }
            </div>
            @if (precioConfig > 0)
            {
                <form asp-action="AplicarPrecio" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fecha" value="@fecha" />
                    <input type="hidden" name="precio" value="@precioConfig.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                    <button type="submit" class="btn btn-sm" style="background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.4);color:#fbbf24;white-space:nowrap;">
                        <i class="fa-solid fa-rotate"></i> Aplicar $@precioConfig.ToString("N2") a @visitasSinPrecio visita(s)
                    </button>
                </form>
            }
        </div>
    }

    @* ── Selector de fecha / mes ── *@
    <form method="get" style="margin-bottom:24px;">
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            <button type="button" onclick="setModo('dia')"
                style="padding:5px 14px;border-radius:8px;border:1px solid @(modo=="dia"?"var(--accent)":"var(--border)");background:@(modo=="dia"?"rgba(0,242,255,0.12)":"transparent");color:@(modo=="dia"?"var(--accent)":"var(--text-muted)");font-size:12px;cursor:pointer;">
                <i class="fa-solid fa-calendar-day"></i> Por día
            </button>
            <button type="button" onclick="setModo('mes')"
                style="padding:5px 14px;border-radius:8px;border:1px solid @(modo=="mes"?"var(--accent)":"var(--border)");background:@(modo=="mes"?"rgba(0,242,255,0.12)":"transparent");color:@(modo=="mes"?"var(--accent)":"var(--text-muted)");font-size:12px;cursor:pointer;">
                <i class="fa-solid fa-calendar-month"></i> Por mes
            </button>
        </div>
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
            <div id="wrapDia" class="form-group" style="margin:0;@(modo=="mes"?"display:none;":"")">
                <label class="form-label">Fecha</label>
                <input type="date" name="fecha" class="form-control" value="@fecha" />
            </div>
            <div id="wrapMes" class="form-group" style="margin:0;@(modo=="dia"?"display:none;":"")">
                <label class="form-label">Mes</label>
                <input type="month" name="mes" class="form-control" value="@mes" />
            </div>
            <input type="hidden" name="modo" id="hidModo" value="@modo" />
            <button type="submit" class="btn btn-primary btn-sm" style="align-self:flex-end;">
                <i class="fa-solid fa-filter"></i> Ver corte
            </button>
        </div>
    </form>

    @* ── Resumen en tarjetas ── *@
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:28px;">
        <div style="background:rgba(167,139,250,0.08);border:1px solid rgba(167,139,250,0.25);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Visitas de día</div>
            <div style="font-size:22px;font-weight:700;color:#a78bfa;margin-top:4px;">@visitas.Count</div>
            <div style="font-size:13px;color:#a78bfa;margin-top:2px;">$@totalVisitas.ToString("N2")</div>
        </div>
        <div style="background:rgba(251,146,60,0.08);border:1px solid rgba(251,146,60,0.25);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Ventas productos</div>
            <div style="font-size:22px;font-weight:700;color:#fb923c;margin-top:4px;">@totalUnidadesVentas <span style="font-size:12px;font-weight:400;color:var(--text-muted);">unid.</span></div>
            <div style="font-size:13px;color:#fb923c;margin-top:2px;">$@totalVentas.ToString("N2")</div>
        </div>
        <div style="background:rgba(56,189,248,0.08);border:1px solid rgba(56,189,248,0.25);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Pagos membresías</div>
            <div style="font-size:22px;font-weight:700;color:#38bdf8;margin-top:4px;">@pagos.Count</div>
            <div style="font-size:13px;color:#38bdf8;margin-top:2px;">$@totalPagos.ToString("N2")</div>
        </div>
        <div style="background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.3);border-radius:var(--radius);padding:14px 18px;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">@(modo=="mes"?"Total del mes":"Total del día")</div>
            <div style="font-size:26px;font-weight:800;color:#4ade80;margin-top:4px;">$@totalDia.ToString("N2")</div>
        </div>
    </div>

    @* ── Visitas de día ── *@
    @if (visitas.Any())
    {
        <div style="margin-bottom:28px;">
            <h3 style="font-size:14px;font-weight:600;color:#a78bfa;margin-bottom:10px;display:flex;align-items:center;gap:8px;">
                <i class="fa-solid fa-person-walking-arrow-right"></i> Visitas de día (@visitas.Count)
            </h3>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Visitante</th>
                            <th style="text-align:right;">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in visitas)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@(modo=="mes" ? v.FechaCreacion?.ToString("dd/MM HH:mm") : v.FechaCreacion?.ToString("HH:mm"))</td>
                            <td class="name-cell">@v.NombreVisita</td>
                            <td style="text-align:right;color:#a78bfa;font-weight:600;">$@v.PrecioVisita.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="background:rgba(167,139,250,0.07);font-weight:700;">
                            <td colspan="2" style="text-align:right;font-size:13px;color:var(--text-muted);">Subtotal visitas</td>
                            <td style="text-align:right;color:#a78bfa;">$@totalVisitas.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="margin-bottom:28px;padding:14px;background:rgba(167,139,250,0.04);border:1px solid rgba(167,139,250,0.15);border-radius:var(--radius);color:var(--text-muted);font-size:13px;">
            <i class="fa-solid fa-person-walking-arrow-right"></i> Sin visitas de día registradas
        </div>
    }

    @* ── Ventas de productos ── *@
    @if (ventas.Any())
    {
        <div style="margin-bottom:24px;">
            <h3 style="font-size:14px;font-weight:600;color:#fb923c;margin-bottom:10px;display:flex;align-items:center;gap:8px;">
                <i class="fa-solid fa-bag-shopping"></i> Ventas de productos (@totalUnidadesVentas @(totalUnidadesVentas == 1 ? "unidad" : "unidades"))
            </h3>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Producto</th>
                            <th style="text-align:right;">Cant.</th>
                            <th style="text-align:right;">Total</th>
                            <th style="text-align:right;">Ganancia</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var v in ventas)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@(modo=="mes" ? v.IdSalidaNavigation?.FechaCreacion?.ToString("dd/MM HH:mm") : v.IdSalidaNavigation?.FechaCreacion?.ToString("HH:mm"))</td>
                            <td class="name-cell">@v.IdProductoNavigation?.Nombre</td>
                            <td style="text-align:right;color:var(--text-muted);">@v.Cantidad</td>
                            <td style="text-align:right;color:#fb923c;font-weight:600;">$@(((v.PrecioUnitario ?? 0) * v.Cantidad).ToString("N2"))</td>
                            <td style="text-align:right;font-size:12px;color:var(--text-muted);">$@(((v.PrecioUnitario ?? 0) - (v.IdProductoNavigation?.Costo ?? 0)) * v.Cantidad).ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="background:rgba(251,146,60,0.07);font-weight:700;">
                            <td colspan="3" style="text-align:right;font-size:13px;color:var(--text-muted);">Subtotal ventas</td>
                            <td style="text-align:right;color:#fb923c;">$@totalVentas.ToString("N2")</td>
                            <td style="text-align:right;color:var(--text-muted);font-size:12px;">$@ventas.Sum(v => ((v.PrecioUnitario ?? 0) - (v.IdProductoNavigation?.Costo ?? 0)) * v.Cantidad).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="margin-bottom:24px;padding:14px;background:rgba(251,146,60,0.04);border:1px solid rgba(251,146,60,0.15);border-radius:var(--radius);color:var(--text-muted);font-size:13px;">
            <i class="fa-solid fa-bag-shopping"></i> Sin ventas de productos en este día
        </div>
    }

    @* ── Pagos de membresías ── *@
    @if (pagos.Any())
    {
        <div style="margin-bottom:28px;">
            <h3 style="font-size:14px;font-weight:600;color:#38bdf8;margin-bottom:10px;display:flex;align-items:center;gap:8px;">
                <i class="fa-solid fa-id-card"></i> Pagos de membresías (@pagos.Count)
            </h3>
            <div class="table-responsive">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Hora</th>
                            <th>Socio</th>
                            <th>Plan</th>
                            <th>Método</th>
                            <th style="text-align:right;">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in pagos)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:12px;">@(modo=="mes" ? p.FechaCreacion?.ToString("dd/MM HH:mm") : p.FechaCreacion?.ToString("HH:mm"))</td>
                            <td class="name-cell">
                                @if (p.IdSocioNavigation != null)
                                {
                                    <span>@p.IdSocioNavigation.Nombre @p.IdSocioNavigation.Paterno</span>
                                    <span class="text-muted" style="font-size:11px;margin-left:5px;">#@p.IdSocio</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td>
                                @if (p.IdMembresiaNavigation != null)
                                { <span class="badge badge-info">@p.IdMembresiaNavigation.Nombre</span> }
                                else { <span class="text-muted" style="font-size:12px;">—</span> }
                            </td>
                            <td style="font-size:13px;">@p.MetodoPago</td>
                            <td style="text-align:right;color:#38bdf8;font-weight:600;">$@p.Monto.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr style="background:rgba(56,189,248,0.07);font-weight:700;">
                            <td colspan="4" style="text-align:right;font-size:13px;color:var(--text-muted);">Subtotal membresías</td>
                            <td style="text-align:right;color:#38bdf8;">$@totalPagos.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="margin-bottom:28px;padding:14px;background:rgba(56,189,248,0.04);border:1px solid rgba(56,189,248,0.15);border-radius:var(--radius);color:var(--text-muted);font-size:13px;">
            <i class="fa-solid fa-id-card"></i> Sin pagos de membresías en este día
        </div>
    }

    @* ── Total final ── *@
    <div style="border-top:1px solid var(--border);padding-top:16px;display:flex;justify-content:flex-end;">
        <div style="background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.3);border-radius:var(--radius);padding:12px 24px;text-align:right;">
            <div class="text-muted" style="font-size:11px;text-transform:uppercase;letter-spacing:1px;">Total @(modo=="mes"?"del mes de":"generado el") @fechaDisplay</div>
            <div style="font-size:28px;font-weight:800;color:#4ade80;margin-top:4px;">$@totalDia.ToString("N2")</div>
            @if (totalDia > 0)
            {
                <div class="text-muted" style="font-size:11px;margin-top:2px;">
                    Visitas $@totalVisitas.ToString("N2") + Ventas $@totalVentas.ToString("N2") + Membresías $@totalPagos.ToString("N2")
                </div>
            }
        </div>
    </div>
</div>

<script>
function setModo(v) {
    document.getElementById('hidModo').value = v;
    document.getElementById('wrapDia').style.display = v === 'dia' ? '' : 'none';
    document.getElementById('wrapMes').style.display = v === 'mes' ? '' : 'none';
}
</script>
