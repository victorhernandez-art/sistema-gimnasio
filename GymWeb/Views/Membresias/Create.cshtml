@model GymWeb.Models.Membresium

<div class="card" style="max-width:540px;">
    <div class="card-header">
        <div class="card-title"><i class="fa-solid fa-plus"></i> Nueva Membresía</div>
        <a asp-action="Index" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Volver</a>
    </div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group" style="grid-column:1/-1;">
                <label class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Membresía Mensual" required />
            </div>
            <div class="form-group">
                <label class="form-label">Duración (días)</label>
                <input asp-for="Meses" type="number" class="form-control" min="1" required placeholder="Ej: 30" />
                <div class="text-muted" style="font-size:11px;margin-top:4px;">1 día · 7 días · 15 días · 30 días o el valor que necesites</div>
            </div>
            <div class="form-group">
                <label class="form-label">Precio ($)</label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Hora Inicio (opcional)</label>
                <input asp-for="HoraInicio" type="time" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Hora Fin (opcional)</label>
                <input asp-for="HoraFinal" type="time" class="form-control" />
            </div>
        </div>
        <div style="margin-top:20px;display:flex;gap:10px;">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline">Cancelar</a>
        </div>
    </form>
</div>
