<!-- ══════════════════════════════════════════════════════════════════════
     LÓGICA JAVASCRIPT: CARRITO POS + CHECKOUT + ATRIBUTOS REACTIVOS
══════════════════════════════════════════════════════════════════════════ -->
<script>
(function() {
    const CSRF = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    // Estado del Carrito en memoria (Local POS)
    let cart = []; // [{ id, nombre, categoria, precio, stock, img, cantidad }]
    let selectedPaymentMethod = 'Efectivo';
    let activeCategory = 'todos';

    // ── Atajo de teclado Ctrl + K ──
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            const input = document.getElementById('tiendaSearchInput');
            if (input) { input.focus(); input.select(); }
        }
        if (e.key === 'Escape') {
            cerrarModalCheckout();
            cerrarModalConfirmacion();
            cerrarModalDetalleVenta();
            cerrarModalProducto();
            cerrarModalStock();
        }
    });

    // ── Buscador Reactivo ──
    const searchInput = document.getElementById('tiendaSearchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            aplicarFiltrosProductos();
        });
    }

    // ── Filtro de Categoría ──
    window.seleccionarCategoriaPill = function(btn, cat) {
        document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = cat;
        aplicarFiltrosProductos();
    };

    window.aplicarFiltrosProductos = function() {
        const query = (document.getElementById('tiendaSearchInput')?.value ?? '').toLowerCase().trim();
        const soloStock = document.getElementById('switchSoloStock')?.checked ?? false;

        document.querySelectorAll('.product-card').forEach(card => {
            const nom = (card.dataset.nombre ?? '').toLowerCase();
            const cat = (card.dataset.categoria ?? '').toLowerCase();
            const stock = parseInt(card.dataset.stock ?? '0');
            const stockBajo = card.dataset.stockbajo === 'true';

            // Filtro por texto (nombre o categoría)
            const matchQuery = !query || nom.includes(query) || cat.includes(query);

            // Filtro por categoría pill
            let matchCat = false;
            if (activeCategory === 'todos') {
                matchCat = true;
            } else if (activeCategory === 'stock-bajo') {
                matchCat = stockBajo;
            } else {
                matchCat = cat.includes(activeCategory.toLowerCase());
            }

            // Filtro solo con stock
            const matchStock = !soloStock || stock > 0;

            if (matchQuery && matchCat && matchStock) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    };

    // ── Funciones del Carrito ──
    window.agregarAlCarrito = function(idProducto) {
        const card = document.querySelector(`.product-card[data-id="${idProducto}"]`);
        if (!card) return;

        const stock = parseInt(card.dataset.stock ?? '0');
        if (stock <= 0) {
            alert('Este producto se encuentra agotado.');
            return;
        }

        const existing = cart.find(i => i.id === idProducto);
        if (existing) {
            if (existing.cantidad + 1 > stock) {
                alert(`Stock máximo alcanzado para este producto (${stock} disponibles).`);
                return;
            }
            existing.cantidad += 1;
        } else {
            cart.push({
                id: idProducto,
                nombre: card.dataset.nombre,
                categoria: card.dataset.categoria,
                precio: parseFloat(card.dataset.precio ?? '0'),
                stock: stock,
                img: card.dataset.img,
                cantidad: 1
            });
        }

        renderCart();

        // Efecto visual en la tarjeta
        card.style.transform = 'scale(0.98)';
        setTimeout(() => card.style.transform = '', 150);
    };

    window.cambiarCantidadItem = function(idProducto, delta) {
        const item = cart.find(i => i.id === idProducto);
        if (!item) return;

        const nueva = item.cantidad + delta;
        if (nueva > item.stock) {
            alert(`Solo hay ${item.stock} unidades disponibles en inventario.`);
            return;
        }

        if (nueva <= 0) {
            eliminarItemCarrito(idProducto);
        } else {
            item.cantidad = nueva;
            renderCart();
        }
    };

    window.eliminarItemCarrito = function(idProducto) {
        cart = cart.filter(i => i.id !== idProducto);
        renderCart();
    };

    window.vaciarCarrito = function() {
        if (!cart.length) return;
        if (confirm('¿Vaciar todos los productos del carrito?')) {
            cart = [];
            renderCart();
        }
    };

    function renderCart() {
        const container = document.getElementById('cartItemsList');
        const emptyView = document.getElementById('cartEmptyState');
        const footerView = document.getElementById('cartFooterSection');
        const countHeader = document.getElementById('cartCountHeader');
        const topBadge = document.getElementById('topCartBadge');
        const topTotal = document.getElementById('topCartTotal');

        const totalItemsCount = cart.reduce((acc, i) => acc + i.cantidad, 0);
        if (countHeader) countHeader.textContent = totalItemsCount;
        if (topBadge) topBadge.textContent = totalItemsCount;

        if (cart.length === 0) {
            if (container) container.innerHTML = '';
            if (emptyView) emptyView.style.display = 'flex';
            if (footerView) footerView.style.display = 'none';
            if (topTotal) topTotal.textContent = '$0.00';
            return;
        }

        if (emptyView) emptyView.style.display = 'none';
        if (footerView) footerView.style.display = 'flex';

        let html = '';
        cart.forEach(item => {
            const subtotal = item.precio * item.cantidad;
            html += `
                <div class="cart-item-row" data-id="${item.id}">
                    <img src="${item.img}" class="cart-item-thumb" alt="${item.nombre}" />
                    <div class="cart-item-info">
                        <div class="cart-item-name" title="${item.nombre}">${item.nombre}</div>
                        <div class="cart-item-unit-price">$${item.precio.toFixed(2)} c/u</div>
                    </div>
                    <div class="cart-item-controls">
                        <button type="button" class="cart-btn-qty" onclick="cambiarCantidadItem(${item.id}, -1)">-</button>
                        <span class="cart-qty-text">${item.cantidad}</span>
                        <button type="button" class="cart-btn-qty" onclick="cambiarCantidadItem(${item.id}, 1)">+</button>
                    </div>
                    <div class="cart-item-subtotal">$${subtotal.toFixed(2)}</div>
                    <button type="button" class="cart-btn-del" onclick="eliminarItemCarrito(${item.id})" title="Quitar">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            `;
        });

        if (container) container.innerHTML = html;
        actualizarTotalesCarrito();
    }

    window.actualizarTotalesCarrito = function() {
        const subtotal = cart.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
        const descInput = document.getElementById('cartDiscountInput');
        let desc = parseFloat(descInput?.value ?? '0') || 0;
        if (desc < 0) desc = 0;
        if (desc > subtotal) desc = subtotal;

        const total = Math.max(0, subtotal - desc);

        const subText = document.getElementById('cartSubtotalText');
        const totText = document.getElementById('cartTotalText');
        const topTotal = document.getElementById('topCartTotal');

        const formattedTot = '$' + total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        const formattedSub = '$' + subtotal.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

        if (subText) subText.textContent = formattedSub;
        if (totText) totText.textContent = formattedTot;
        if (topTotal) topTotal.textContent = formattedTot;
    };

    // ── Toggle Carrito en Pantallas Móviles ──
    window.toggleMobileCart = function() {
        const panel = document.getElementById('tiendaCartPanel');
        if (panel) {
            panel.classList.toggle('open-drawer');
        }
    };

    // ── Cambio de Pestañas: Productos vs Historial ──
    window.cambiarTabModulo = function(tab) {
        const secProd = document.getElementById('seccionProductos');
        const secHist = document.getElementById('seccionHistorial');
        const btnP = document.getElementById('tabBtnProductos');
        const btnH = document.getElementById('tabBtnHistorial');
        const toggleStock = document.getElementById('wrapperFiltroStock');

        if (tab === 'productos') {
            if (secProd) secProd.style.display = 'grid';
            if (secHist) secHist.style.display = 'none';
            btnP.classList.add('active');
            btnH.classList.remove('active');
            if (toggleStock) toggleStock.style.display = 'flex';
        } else {
            if (secProd) secProd.style.display = 'none';
            if (secHist) secHist.style.display = 'block';
            btnH.classList.add('active');
            btnP.classList.remove('active');
            if (toggleStock) toggleStock.style.display = 'none';
            filtrarHistorialVentas();
        }
    };

    // ── CHECKOUT MODAL ──
    window.abrirModalCheckout = function() {
        if (!cart.length) {
            alert('Agrega al menos un producto al carrito antes de cobrar.');
            return;
        }

        const subtotal = cart.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
        let desc = parseFloat(document.getElementById('cartDiscountInput')?.value ?? '0') || 0;
        const total = Math.max(0, subtotal - desc);

        const totalDisp = document.getElementById('checkoutTotalDisplay');
        const noteDisp  = document.getElementById('checkoutDiscountNote');
        if (totalDisp) totalDisp.textContent = '$' + total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        if (noteDisp) {
            noteDisp.textContent = desc > 0 ? `(Subtotal: $${subtotal.toFixed(2)} - Descuento: $${desc.toFixed(2)})` : '';
        }

        // Reset inputs de checkout
        document.getElementById('inputEfectivoRecibido').value = '';
        document.getElementById('displayCambioCalculado').textContent = '$0.00';
        document.getElementById('efectivoErrorMsg').style.display = 'none';
        document.getElementById('inputTransferReferencia').value = '';
        document.getElementById('inputTransferNotas').value = '';
        document.getElementById('inputTarjetaReferencia').value = '';
        document.getElementById('inputTarjetaNotas').value = '';
        document.getElementById('checkoutGlobalError').style.display = 'none';

        seleccionarMetodoPago('Efectivo');
        document.getElementById('modalCheckout').style.display = 'flex';
        setTimeout(() => document.getElementById('inputEfectivoRecibido')?.focus(), 150);
    };

    window.cerrarModalCheckout = function() {
        const modal = document.getElementById('modalCheckout');
        if (modal) modal.style.display = 'none';
    };

    window.seleccionarMetodoPago = function(metodo) {
        selectedPaymentMethod = metodo;
        document.querySelectorAll('.method-card').forEach(b => {
            b.classList.toggle('active', b.dataset.method === metodo);
        });

        document.getElementById('formMetodoEfectivo').style.display = (metodo === 'Efectivo') ? 'block' : 'none';
        document.getElementById('formMetodoTransferencia').style.display = (metodo === 'Transferencia') ? 'block' : 'none';
        document.getElementById('formMetodoTarjeta').style.display = (metodo === 'Tarjeta') ? 'block' : 'none';

        if (metodo === 'Efectivo') {
            calcularCambioEfectivo();
        } else {
            document.getElementById('btnConfirmarVentaFinal').disabled = false;
        }
    };

    window.calcularCambioEfectivo = function() {
        const subtotal = cart.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
        let desc = parseFloat(document.getElementById('cartDiscountInput')?.value ?? '0') || 0;
        const total = Math.max(0, subtotal - desc);

        const recInput = document.getElementById('inputEfectivoRecibido');
        const val = parseFloat(recInput?.value ?? '0') || 0;
        const btn = document.getElementById('btnConfirmarVentaFinal');
        const err = document.getElementById('efectivoErrorMsg');
        const disp = document.getElementById('displayCambioCalculado');

        if (!val || val < total) {
            if (disp) disp.textContent = '$0.00';
            if (val > 0) {
                if (err) err.style.display = 'block';
            } else {
                if (err) err.style.display = 'none';
            }
            if (btn) btn.disabled = true;
        } else {
            const cambio = val - total;
            if (disp) disp.textContent = '$' + cambio.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            if (err) err.style.display = 'none';
            if (btn) btn.disabled = false;
        }
    };

    window.setEfectivoExacto = function() {
        const subtotal = cart.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
        let desc = parseFloat(document.getElementById('cartDiscountInput')?.value ?? '0') || 0;
        const total = Math.max(0, subtotal - desc);
        document.getElementById('inputEfectivoRecibido').value = total.toFixed(2);
        calcularCambioEfectivo();
    };

    window.addEfectivoRecibido = function(monto) {
        const curr = parseFloat(document.getElementById('inputEfectivoRecibido')?.value ?? '0') || 0;
        document.getElementById('inputEfectivoRecibido').value = (curr + monto).toFixed(2);
        calcularCambioEfectivo();
    };

    // ── Procesar y Confirmar Venta Final ──
    window.procesarConfirmarVenta = async function() {
        const btn = document.getElementById('btnConfirmarVentaFinal');
        const err = document.getElementById('checkoutGlobalError');
        err.style.display = 'none';

        const subtotal = cart.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
        let desc = parseFloat(document.getElementById('cartDiscountInput')?.value ?? '0') || 0;
        const total = Math.max(0, subtotal - desc);

        let rec = null, cambio = null, ref = null, notas = null;

        if (selectedPaymentMethod === 'Efectivo') {
            rec = parseFloat(document.getElementById('inputEfectivoRecibido')?.value ?? '0') || 0;
            if (rec < total) {
                err.textContent = 'El efectivo recibido debe ser mayor o igual al total a pagar.';
                err.style.display = 'block';
                return;
            }
            cambio = Math.max(0, rec - total);
        } else if (selectedPaymentMethod === 'Transferencia') {
            ref = document.getElementById('inputTransferReferencia')?.value ?? '';
            notas = document.getElementById('inputTransferNotas')?.value ?? '';
        } else if (selectedPaymentMethod === 'Tarjeta') {
            ref = document.getElementById('inputTarjetaReferencia')?.value ?? '';
            notas = document.getElementById('inputTarjetaNotas')?.value ?? '';
        }

        const payload = {
            items: cart.map(i => ({ idProducto: i.id, cantidad: i.cantidad })),
            metodoPago: selectedPaymentMethod,
            descuento: desc,
            montoRecibido: rec,
            cambio: cambio,
            referencia: ref,
            notas: notas
        };

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Procesando...';

        try {
            const resp = await fetch('/Productos/CobrarVenta', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': CSRF
                },
                body: JSON.stringify(payload)
            });

            const data = await resp.json();
            if (!data.ok) {
                err.textContent = data.msg ?? 'Error al procesar la venta.';
                err.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Confirmar venta';
                return;
            }

            // Actualizar inventario en el DOM local para evitar recarga obligada
            data.items.forEach(it => {
                const card = document.querySelector(`.product-card[data-id="${it.idProducto}"]`);
                if (card) {
                    card.dataset.stock = it.nuevoStock;
                    const stockTag = card.querySelector('.product-stock-tag span:last-child');
                    if (stockTag) stockTag.textContent = `Stock: ${it.nuevoStock} u`;

                    if (it.nuevoStock <= 0) {
                        card.dataset.agotado = 'true';
                        const btnAdd = card.querySelector('.btn-add-cart');
                        if (btnAdd) {
                            btnAdd.classList.add('disabled');
                            btnAdd.disabled = true;
                            btnAdd.innerHTML = '<i class="fa-solid fa-ban"></i> Agotado';
                        }
                    }
                }
            });

            // Cerrar checkout y vaciar carrito
            cerrarModalCheckout();
            cart = [];
            renderCart();

            // Mostrar modal de confirmación
            mostrarTicketConfirmacion(data);

        } catch (ex) {
            err.textContent = 'Error de red o comunicación con el servidor.';
            err.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Confirmar venta';
        }
    };

