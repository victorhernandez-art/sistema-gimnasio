    // ── HISTORIAL DE VENTAS: FILTROS Y DETALLE ──
    window.filtrarHistorialVentas = function() {
        const query  = (document.getElementById('histSearchText')?.value ?? '').toLowerCase().trim();
        const metodo = (document.getElementById('histFilterMetodo')?.value ?? '').trim();
        const desde  = document.getElementById('histFilterDesde')?.value ?? '';
        const hasta  = document.getElementById('histFilterHasta')?.value ?? '';

        let visibles = 0;
        document.querySelectorAll('.hist-row').forEach(row => {
            const fol = row.dataset.folio ?? '';
            const prods = row.dataset.prods ?? '';
            const met = row.dataset.metodo ?? '';
            const fecha = row.dataset.fecha ?? '';

            const okText = !query || fol.includes(query) || prods.includes(query);
            const okMetodo = !metodo || met === metodo;
            const okDesde = !desde || fecha >= desde;
            const okHasta = !hasta || fecha <= hasta;

            const visible = okText && okMetodo && okDesde && okHasta;
            row.style.display = visible ? '' : 'none';
            if (visible) visibles++;
        });

        const badge = document.getElementById('histCounterBadge');
        if (badge) badge.textContent = `${visibles} venta${visibles !== 1 ? 's' : ''} encontrada${visibles !== 1 ? 's' : ''}`;
    };

    window.limpiarFiltrosHistorial = function() {
        document.getElementById('histSearchText').value = '';
        document.getElementById('histFilterMetodo').value = '';
        document.getElementById('histFilterDesde').value = '';
        document.getElementById('histFilterHasta').value = '';
        filtrarHistorialVentas();
    };

    // ── Ver Detalle de Venta en Modal ──
    window.verDetalleVenta = async function(idSalida) {
        try {
            const resp = await fetch(`/Productos/GetDetalleVenta?idSalida=${idSalida}`);
            const data = await resp.json();
            if (!data.ok) {
                alert(data.msg ?? 'No se pudo cargar el detalle.');
                return;
            }

            ultimoDetalleConsultado = data;

            document.getElementById('detFolioText').textContent = data.folio;
            document.getElementById('detFechaText').textContent = data.fecha;
            document.getElementById('detUsuarioText').textContent = data.usuario;
            document.getElementById('detMetodoText').textContent = data.metodoPago;

            const refContainer = document.getElementById('detRefContainer');
            const refVal = data.referencia || data.notas;
            if (refVal) {
                document.getElementById('detReferenciaText').textContent = refVal;
                refContainer.style.display = 'block';
            } else {
                refContainer.style.display = 'none';
            }

            // Items table
            let tbody = '';
            data.items.forEach(it => {
                tbody += `
                    <tr>
                        <td>
                            <strong>${it.nombre}</strong>
                            <div style="font-size:11px;color:var(--text-muted);">${it.categoria}</div>
                        </td>
                        <td style="text-align:center;">${it.cantidad}</td>
                        <td style="text-align:right;">$${it.precioUnitario.toFixed(2)}</td>
                        <td style="text-align:right;font-weight:700;color:var(--pos-cyan);">$${it.subtotal.toFixed(2)}</td>
                    </tr>
                `;
            });
            document.getElementById('detItemsTableBody').innerHTML = tbody;

            document.getElementById('detSubtotalNum').textContent = '$' + data.subtotal.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

            const descRow = document.getElementById('detDescuentoRow');
            if (data.descuento > 0) {
                document.getElementById('detDescuentoNum').textContent = '-$' + data.descuento.toFixed(2);
                descRow.style.display = 'flex';
            } else {
                descRow.style.display = 'none';
            }

            document.getElementById('detTotalNum').textContent = '$' + data.total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

            document.getElementById('modalDetalleVenta').style.display = 'flex';
        } catch (e) {
            alert('Error al consultar el detalle de la venta.');
        }
    };

    window.cerrarModalDetalleVenta = function() {
        document.getElementById('modalDetalleVenta').style.display = 'none';
    };

    // ── MODALES DE INVENTARIO: NUEVO / EDITAR / REABASTECER ──
    window.previewFotoProducto = function(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('prodPhotoImgPreview').src = e.target.result;
                document.getElementById('photoPreviewWrap').style.display = 'flex';
                document.getElementById('photoDropPrompt').style.display = 'none';
                document.getElementById('prodEliminarFoto').value = 'false';

                const badge = document.getElementById('photoFileNameBadge');
                if (badge) {
                    const sizeKb = (file.size / 1024).toFixed(0);
                    badge.innerHTML = `<i class="fa-solid fa-circle-check" style="color:#4ade80;"></i> Foto seleccionada: <strong>${file.name}</strong> (${sizeKb} KB)`;
                    badge.style.display = 'flex';
                }
            };
            reader.readAsDataURL(file);
        }
    };

    window.quitarFotoSeleccionada = function() {
        const fileInput = document.getElementById('prodFotoFile');
        if (fileInput) fileInput.value = '';
        document.getElementById('prodPhotoImgPreview').src = '';
        document.getElementById('photoPreviewWrap').style.display = 'none';
        document.getElementById('photoDropPrompt').style.display = 'flex';
        document.getElementById('prodEliminarFoto').value = 'true';
        const badge = document.getElementById('photoFileNameBadge');
        if (badge) {
            badge.innerHTML = '';
            badge.style.display = 'none';
        }
    };

    window.abrirModalProducto = function() {
        document.getElementById('modalProdTitulo').innerHTML = '<i class="fa-solid fa-box text-cyan"></i> Nuevo Producto';
        document.getElementById('prodId').value = '0';
        document.getElementById('prodNombre').value = '';
        document.getElementById('prodCategoria').value = 'Suplemento';
        quitarFotoSeleccionada();
        document.getElementById('prodEliminarFoto').value = 'false';
        document.getElementById('prodPrecio').value = '';
        document.getElementById('prodCosto').value = '';
        document.getElementById('prodStock').value = '0';
        document.getElementById('prodStockMin').value = '5';
        document.getElementById('prodDescripcion').value = '';
        document.getElementById('modalProdMsg').style.display = 'none';
        document.getElementById('modalProducto').style.display = 'flex';
    };

    window.editarProducto = async function(id) {
        const r = await fetch(`/Productos/GetProducto?id=${id}`);
        const data = await r.json();
        document.getElementById('modalProdTitulo').innerHTML = '<i class="fa-solid fa-pen text-cyan"></i> Editar Producto';
        document.getElementById('prodId').value = data.idProducto;
        document.getElementById('prodNombre').value = data.nombre ?? '';
        document.getElementById('prodCategoria').value = data.categoria ?? 'Otro';

        if (data.imagenUrl) {
            document.getElementById('prodPhotoImgPreview').src = data.imagenUrl;
            document.getElementById('photoPreviewWrap').style.display = 'flex';
            document.getElementById('photoDropPrompt').style.display = 'none';
            const badge = document.getElementById('photoFileNameBadge');
            if (badge) {
                badge.innerHTML = `<i class="fa-solid fa-image text-cyan"></i> Foto guardada en el servidor (puedes cambiarla)`;
                badge.style.display = 'flex';
            }
        } else {
            quitarFotoSeleccionada();
        }
        document.getElementById('prodEliminarFoto').value = 'false';

        document.getElementById('prodPrecio').value = data.precio ?? '';
        document.getElementById('prodCosto').value = data.costo ?? '';
        document.getElementById('prodStock').value = data.stock ?? 0;
        document.getElementById('prodStockMin').value = data.stockMinimo ?? 5;
        document.getElementById('prodDescripcion').value = data.descripcion ?? '';
        document.getElementById('modalProdMsg').style.display = 'none';
        document.getElementById('modalProducto').style.display = 'flex';
    };

    window.cerrarModalProducto = function() {
        document.getElementById('modalProducto').style.display = 'none';
    };

    window.guardarProducto = async function() {
        const id = parseInt(document.getElementById('prodId').value);
        const nombre = document.getElementById('prodNombre').value.trim();
        const precio = parseFloat(document.getElementById('prodPrecio').value);
        const msg = document.getElementById('modalProdMsg');

        if (!nombre) { msg.textContent = 'El nombre es obligatorio.'; msg.style.display = 'block'; return; }
        if (!precio || precio <= 0) { msg.textContent = 'El precio debe ser mayor a 0.'; msg.style.display = 'block'; return; }

        const fd = new FormData();
        fd.append('__RequestVerificationToken', CSRF);
        fd.append('nombre', nombre);
        fd.append('categoria', document.getElementById('prodCategoria').value);

        const fileInput = document.getElementById('prodFotoFile');
        if (fileInput.files && fileInput.files[0]) {
            fd.append('foto', fileInput.files[0]);
        }
        fd.append('eliminarFoto', document.getElementById('prodEliminarFoto').value);

        fd.append('precio', precio);
        fd.append('costo', document.getElementById('prodCosto').value || '');
        fd.append('stock', document.getElementById('prodStock').value || '0');
        fd.append('stockMinimo', document.getElementById('prodStockMin').value || '5');
        fd.append('descripcion', document.getElementById('prodDescripcion').value);

        const url = id > 0 ? `/Productos/EditAjax?id=${id}` : '/Productos/CreateAjax';
        const r = await fetch(url, { method: 'POST', body: fd });
        const res = await r.json();

        if (!res.ok) { msg.textContent = res.msg ?? 'Error.'; msg.style.display = 'block'; return; }
        location.reload();
    };

    window.abrirModalStock = function(id, nombre, stockActual) {
        document.getElementById('stockProdId').value = id;
        document.getElementById('stockProdNombre').textContent = nombre;
        document.getElementById('stockActual').textContent = stockActual;
        document.getElementById('stockCantidad').value = 1;
        document.getElementById('stockNuevo').textContent = (stockActual + 1) + ' u';
        document.getElementById('modalStockMsg').style.display = 'none';
        document.getElementById('modalStock').style.display = 'flex';
        document.getElementById('stockCantidad').focus();
    };

    window.cerrarModalStock = function() {
        document.getElementById('modalStock').style.display = 'none';
    };

    document.getElementById('stockCantidad')?.addEventListener('input', function() {
        const actual = parseInt(document.getElementById('stockActual').textContent) || 0;
        const agrega = parseInt(this.value) || 0;
        document.getElementById('stockNuevo').textContent = (actual + agrega) + ' u';
    });

    window.confirmarAgregarStock = async function() {
        const id   = document.getElementById('stockProdId').value;
        const cant = parseInt(document.getElementById('stockCantidad').value);
        const msg  = document.getElementById('modalStockMsg');
        if (cant < 1) { msg.textContent = 'Ingresa una cantidad válida.'; msg.style.display = 'block'; return; }

        const fd = new FormData();
        fd.append('__RequestVerificationToken', CSRF);
        fd.append('idProducto', id);
        fd.append('cantidad', cant);

        const r = await fetch('/Productos/AgregarStock', { method: 'POST', body: fd });
        const data = await r.json();
        if (data.ok) {
            cerrarModalStock();
            location.reload();
        } else {
            msg.textContent = data.msg;
            msg.style.display = 'block';
        }
    };

    // Cerrar al hacer clic fuera del card del modal
    ['modalCheckout', 'modalConfirmacionVenta', 'modalDetalleVenta', 'modalProducto', 'modalStock'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('click', e => {
                if (e.target === el) {
                    window['cerrar' + id.charAt(0).toUpperCase() + id.slice(1)]?.();
                }
            });
        }
    });

    // Drag & Drop para foto de producto desde PC
    const photoZone = document.getElementById('prodPhotoUploadZone');
    if (photoZone) {
        ['dragenter', 'dragover'].forEach(evt => {
            photoZone.addEventListener(evt, e => {
                e.preventDefault();
                e.stopPropagation();
                photoZone.classList.add('drag-over');
            });
        });
        ['dragleave', 'drop'].forEach(evt => {
            photoZone.addEventListener(evt, e => {
                e.preventDefault();
                e.stopPropagation();
                photoZone.classList.remove('drag-over');
            });
        });
        photoZone.addEventListener('drop', e => {
            if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
                const fileInput = document.getElementById('prodFotoFile');
                fileInput.files = e.dataTransfer.files;
                previewFotoProducto(fileInput);
            }
        });
    }

    // Inicializar Carrito Vacío
    renderCart();
})();
</script>
