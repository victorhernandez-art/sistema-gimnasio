@using GymWeb.Models
@{
    ViewData["Title"] = "Tienda";
    var productos        = ViewBag.Productos as List<Producto> ?? new();
    var historialSalidas = ViewBag.HistorialSalidas as List<Salidum> ?? new();
    var categorias       = ViewBag.Categorias as List<string> ?? new();
    var ventasCant       = ViewBag.VentasCantidad as Dictionary<int, int> ?? new();
    int idMasVendido     = ViewBag.IdMasVendido != null ? (int)ViewBag.IdMasVendido : 0;

    int ventasHoy        = ViewBag.VentasHoy != null ? (int)ViewBag.VentasHoy : 0;
    decimal ingresosHoy  = ViewBag.IngresosHoy != null ? (decimal)ViewBag.IngresosHoy : 0m;
    int prodVendidosHoy  = ViewBag.ProductosVendidosHoy != null ? (int)ViewBag.ProductosVendidosHoy : 0;
    int stockBajo        = ViewBag.StockBajo != null ? (int)ViewBag.StockBajo : 0;

    string ResolverImg(Producto p)
    {
        if (!string.IsNullOrWhiteSpace(p.ImagenUrl)) return p.ImagenUrl;
        var nom = (p.Nombre ?? "").ToLower();
        var cat = (p.Categoria ?? "").ToLower();

        if (nom.Contains("agua") || nom.Contains("ciel") || nom.Contains("monster") || nom.Contains("bebida") || cat.Contains("bebida"))
            return "/img/productos/bebida.svg";
        if (nom.Contains("whey") || nom.Contains("proteina") || nom.Contains("proteína") || nom.Contains("creatina") || nom.Contains("bcaa") || cat.Contains("suplemento"))
            return "/img/productos/suplemento.svg";
        if (nom.Contains("playera") || nom.Contains("ropa") || nom.Contains("crossfit") || nom.Contains("short") || nom.Contains("pants") || cat.Contains("ropa"))
            return "/img/productos/ropa.svg";
        if (nom.Contains("cuerda") || nom.Contains("banda") || nom.Contains("mancuerna") || nom.Contains("disco") || nom.Contains("equipo") || cat.Contains("equipo"))
            return "/img/productos/equipo.svg";
        if (nom.Contains("shaker") || nom.Contains("termo") || nom.Contains("vaso") || nom.Contains("guante") || cat.Contains("accesorio"))
            return "/img/productos/accesorio.svg";

        return "/img/productos/otro.svg";
    }
}

@Html.AntiForgeryToken()

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible" style="background:rgba(22,163,74,0.15);border:1px solid #16a34a;color:#4ade80;border-radius:10px;padding:12px 16px;margin-bottom:20px;display:flex;align-items:center;gap:10px;">
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════════════
     1. ENCABEZADO DEL MÓDULO TIENDA / POS
══════════════════════════════════════════════════════════════════════════ -->
<div class="tienda-header-bar">
    <!-- Buscador central con atajo Ctrl+K -->
    <div class="tienda-search-container">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input type="text" id="tiendaSearchInput" placeholder="Buscar productos por nombre o categoría..." autocomplete="off" />
        <span class="search-kbd" title="Presiona Ctrl + K para buscar">Ctrl + K</span>
    </div>

    <!-- Botón flotante/badge de Carrito -->
    <div class="tienda-top-actions">
        <button id="btnOpenMobileCart" class="btn-top-cart" onclick="toggleMobileCart()">
            <div class="top-cart-icon-wrap">
                <i class="fa-solid fa-cart-shopping"></i>
                <span id="topCartBadge" class="top-cart-counter">0</span>
            </div>
            <div class="top-cart-text">
                <span class="top-cart-label">Carrito</span>
                <span id="topCartTotal" class="top-cart-amount">$0.00</span>
            </div>
        </button>

        <button onclick="abrirModalProducto()" class="btn-nuevo-prod" title="Crear nuevo producto en inventario">
            <i class="fa-solid fa-plus"></i>
            <span>Nuevo Producto</span>
        </button>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     2. TARJETAS DE RESUMEN (Métricas de HOY)
══════════════════════════════════════════════════════════════════════════ -->
<div class="kpi-cards-grid">
    <div class="kpi-card">
        <div class="kpi-card-header">
            <span class="kpi-title"><i class="fa-solid fa-cart-shopping kpi-icon cyan"></i> Ventas de hoy</span>
            <span class="kpi-badge cyan">Hoy</span>
        </div>
        <div class="kpi-value">@ventasHoy</div>
        <div class="kpi-caption">Transacciones completadas</div>
    </div>

    <div class="kpi-card">
        <div class="kpi-card-header">
            <span class="kpi-title"><i class="fa-solid fa-dollar-sign kpi-icon green"></i> Ingresos de hoy</span>
            <span class="kpi-badge green">Total</span>
        </div>
        <div class="kpi-value text-green">$@ingresosHoy.ToString("N2")</div>
        <div class="kpi-caption">Cobrado en efectivo, trans. y tarjeta</div>
    </div>

    <div class="kpi-card">
        <div class="kpi-card-header">
            <span class="kpi-title"><i class="fa-solid fa-box-open kpi-icon blue"></i> Productos vendidos</span>
            <span class="kpi-badge blue">Unidades</span>
        </div>
        <div class="kpi-value">@prodVendidosHoy</div>
        <div class="kpi-caption">Piezas despachadas hoy</div>
    </div>

    <div class="kpi-card @(stockBajo > 0 ? "kpi-card-alert" : "")">
        <div class="kpi-card-header">
            <span class="kpi-title"><i class="fa-solid fa-triangle-exclamation kpi-icon amber"></i> Stock bajo</span>
            <span class="kpi-badge @(stockBajo > 0 ? "amber" : "gray")">Alerta</span>
        </div>
        <div class="kpi-value @(stockBajo > 0 ? "text-amber" : "")">@stockBajo</div>
        <div class="kpi-caption">Artículos por reabastecer</div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     3. NAVEGACIÓN Y FILTROS POR CATEGORÍA
══════════════════════════════════════════════════════════════════════════ -->
<div class="tienda-nav-row">
    <!-- Pestañas principales -->
    <div class="tienda-tabs">
        <button id="tabBtnProductos" class="tienda-tab-btn active" onclick="cambiarTabModulo('productos')">
            <i class="fa-solid fa-store"></i> Productos
        </button>
        <button id="tabBtnHistorial" class="tienda-tab-btn" onclick="cambiarTabModulo('historial')">
            <i class="fa-solid fa-clock-rotate-left"></i> Historial de ventas
        </button>
    </div>

    <!-- Toggle Solo con stock (visible en vista Productos) -->
    <div id="wrapperFiltroStock" class="stock-toggle-wrap">
        <label class="switch-stock-label" for="switchSoloStock">
            <span class="switch-stock-text"><i class="fa-solid fa-filter"></i> Solo con stock</span>
            <input type="checkbox" id="switchSoloStock" onchange="aplicarFiltrosProductos()" />
            <span class="switch-slider"></span>
        </label>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     4. VISTA PRINCIPAL: PRODUCTOS Y CARRITO POS
══════════════════════════════════════════════════════════════════════════ -->
<div id="seccionProductos" class="tienda-layout-grid">
    <!-- Columna Izquierda: Categorías + Catálogo E-Commerce -->
    <div class="tienda-catalog-col">
        <!-- Filtros de categoría estilo pastillas -->
        <div class="category-chips-scroll">
            <button class="cat-pill active" data-cat="todos" onclick="seleccionarCategoriaPill(this, 'todos')">
                <i class="fa-solid fa-border-all"></i> Todos
            </button>
            <button class="cat-pill" data-cat="Suplemento" onclick="seleccionarCategoriaPill(this, 'Suplemento')">
                <i class="fa-solid fa-capsules"></i> Suplementos
            </button>
            <button class="cat-pill" data-cat="Ropa" onclick="seleccionarCategoriaPill(this, 'Ropa')">
                <i class="fa-solid fa-shirt"></i> Ropa
            </button>
            <button class="cat-pill" data-cat="Equipo" onclick="seleccionarCategoriaPill(this, 'Equipo')">
                <i class="fa-solid fa-dumbbell"></i> Equipo
            </button>
            <button class="cat-pill" data-cat="Bebida" onclick="seleccionarCategoriaPill(this, 'Bebida')">
                <i class="fa-solid fa-bottle-water"></i> Bebidas
            </button>
            <button class="cat-pill" data-cat="Accesorio" onclick="seleccionarCategoriaPill(this, 'Accesorio')">
                <i class="fa-solid fa-tag"></i> Accesorios
            </button>
            <button class="cat-pill" data-cat="Otro" onclick="seleccionarCategoriaPill(this, 'Otro')">
                <i class="fa-solid fa-box"></i> Otros
            </button>
            <button class="cat-pill cat-pill-alert" data-cat="stock-bajo" onclick="seleccionarCategoriaPill(this, 'stock-bajo')">
                <i class="fa-solid fa-triangle-exclamation"></i> Stock bajo
            </button>
        </div>

        <!-- Grid de Tarjetas de Producto -->
        <div id="tiendaProductGrid" class="tienda-cards-grid">
            @foreach (var p in productos)
            {
                var stock = p.Stock;
                var stockMin = p.StockMinimo;
                var stockBajoItem = stock <= stockMin && stock > 0;
                var agotado = stock <= 0;
                var imgSrc = ResolverImg(p);
                var esMasVendido = p.IdProducto == idMasVendido && idMasVendido > 0;
                var categoriaNormalizada = (p.Categoria ?? "Otro").Trim();

                <div class="product-card"
                     data-id="@p.IdProducto"
                     data-nombre="@p.Nombre"
                     data-categoria="@categoriaNormalizada"
                     data-precio="@p.Precio"
                     data-stock="@p.Stock"
                     data-stockbajo="@stockBajoItem.ToString().ToLower()"
                     data-agotado="@agotado.ToString().ToLower()"
                     data-img="@imgSrc">
                    
                    <!-- Imagen con Badge Flotante y Clic para Cambiar Foto -->
                    <div class="product-img-wrapper" onclick="editarProducto(@p.IdProducto)" title="Clic para subir o cambiar foto real del producto">
                        <img src="@imgSrc" alt="@p.Nombre" loading="lazy" />
                        
                        <div class="product-img-hover-hint">
                            <i class="fa-solid fa-camera"></i>
                            <span>Cambiar foto</span>
                        </div>

                        <div class="product-badges-layer">
                            @if (agotado)
                            {
                                <span class="badge-tag tag-agotado">Agotado</span>
                            }
                            else if (stockBajoItem)
                            {
                                <span class="badge-tag tag-stock-bajo">⚠️ Stock bajo</span>
                            }
                            else if (esMasVendido)
                            {
                                <span class="badge-tag tag-mas-vendido">⚡ Más vendido</span>
                            }
                        </div>

                        <!-- Acciones discretas de inventario -->
                        <div class="product-quick-tools">
                            <button onclick="event.stopPropagation(); editarProducto(@p.IdProducto)" class="quick-tool-btn camera" title="Subir o cambiar foto real desde tu PC">
                                <i class="fa-solid fa-camera"></i>
                            </button>
                            <button onclick="event.stopPropagation(); editarProducto(@p.IdProducto)" class="quick-tool-btn" title="Editar producto">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button onclick="event.stopPropagation(); abrirModalStock(@p.IdProducto, '@Html.Raw(p.Nombre?.Replace("'","\\'"))', @p.Stock)" class="quick-tool-btn stock" title="Reabastecer stock">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Datos del producto -->
                    <div class="product-content">
                        <div class="product-category-row">
                            <i class="fa-solid fa-tag cat-icon"></i>
                            <span>@p.Categoria</span>
                        </div>

                        <h3 class="product-title" title="@p.Nombre">@p.Nombre</h3>

                        <div class="product-pricing-row">
                            <div class="product-price">$@p.Precio?.ToString("N2")</div>
                            <div class="product-stock-tag @(agotado ? "stock-cero" : (stockBajoItem ? "stock-alerta" : "stock-ok"))">
                                <span class="stock-dot"></span>
                                <span>Stock: @stock u</span>
                            </div>
                        </div>

                        <!-- Botón Agregar al Carrito -->
                        @if (agotado)
                        {
                            <button class="btn-add-cart disabled" disabled>
                                <i class="fa-solid fa-ban"></i> Agotado
                            </button>
                        }
                        else
                        {
                            <button class="btn-add-cart" onclick="agregarAlCarrito(@p.IdProducto)">
                                <i class="fa-solid fa-cart-plus"></i> Agregar al carrito
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!productos.Any())
            {
                <div class="no-products-msg">
                    <i class="fa-solid fa-box-open empty-icon"></i>
                    <h3>No hay productos registrados</h3>
                    <p>Agrega nuevos productos para comenzar a vender en tu tienda fitness.</p>
                    <button onclick="abrirModalProducto()" class="btn btn-primary" style="margin-top:12px;">
                        <i class="fa-solid fa-plus"></i> Registrar Primer Producto
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Columna Derecha: Panel del Carrito POS (Sticky en Escritorio) -->
    <div id="tiendaCartPanel" class="tienda-cart-col">
        <div class="cart-box">
            <!-- Header del carrito -->
            <div class="cart-header">
                <div class="cart-header-title">
                    <i class="fa-solid fa-cart-shopping cart-title-icon"></i>
                    <span>Carrito de venta</span>
                    <span id="cartCountHeader" class="cart-pill-count">0</span>
                </div>
                <button onclick="vaciarCarrito()" class="cart-clear-btn" title="Vaciar todo el carrito">
                    <i class="fa-regular fa-trash-can"></i> Limpiar
                </button>
            </div>

            <!-- Lista de items en el carrito -->
            <div id="cartItemsList" class="cart-items-container">
                <!-- Se llena dinámicamente con JavaScript -->
            </div>

            <!-- Estado Vacío del Carrito -->
            <div id="cartEmptyState" class="cart-empty-view">
                <div class="cart-empty-circle">
                    <i class="fa-solid fa-cart-plus"></i>
                </div>
                <div class="cart-empty-text">El carrito está vacío</div>
                <div class="cart-empty-sub">Selecciona productos del catálogo para añadirlos a la venta.</div>
            </div>

            <!-- Resumen Financiero y Checkout -->
            <div id="cartFooterSection" class="cart-footer" style="display:none;">
                <div class="cart-summary-line">
                    <span>Subtotal</span>
                    <span id="cartSubtotalText" class="font-bold">$0.00</span>
                </div>

                <div class="cart-discount-row">
                    <div class="discount-label">
                        <i class="fa-solid fa-tag"></i> Descuento ($)
                    </div>
                    <input type="number" id="cartDiscountInput" min="0" step="1" value="0" placeholder="0.00" oninput="actualizarTotalesCarrito()" />
                </div>

                <div class="cart-total-line">
                    <span class="total-label">Total</span>
                    <span id="cartTotalText" class="total-amount">$0.00</span>
                </div>

                <!-- Botón Cobrar Venta -->
                <button id="btnCobrarVenta" class="btn-checkout-action" onclick="abrirModalCheckout()">
                    <span>Cobrar venta</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

                <!-- Métodos de pago aceptados -->
                <div class="cart-accepted-methods">
                    <span><i class="fa-solid fa-money-bill-wave"></i> Efectivo</span>
                    <span><i class="fa-solid fa-building-columns"></i> Transferencia</span>
                    <span><i class="fa-solid fa-credit-card"></i> Tarjeta</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     5. VISTA: HISTORIAL DE VENTAS
══════════════════════════════════════════════════════════════════════════ -->
<div id="seccionHistorial" style="display:none;" class="tienda-historial-container">
    <!-- Barra de filtros del historial -->
    <div class="historial-filter-bar">
        <div class="hist-filter-group" style="flex:2;min-width:200px;">
            <label><i class="fa-solid fa-magnifying-glass"></i> Buscar por folio o producto</label>
            <input type="text" id="histSearchText" placeholder="Folio #000125, Agua, Whey..." oninput="filtrarHistorialVentas()" />
        </div>
        <div class="hist-filter-group">
            <label><i class="fa-solid fa-wallet"></i> Método de pago</label>
            <select id="histFilterMetodo" onchange="filtrarHistorialVentas()">
                <option value="">Todos los métodos</option>
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>
                <option value="Tarjeta">Tarjeta</option>
            </select>
        </div>
        <div class="hist-filter-group">
            <label><i class="fa-regular fa-calendar"></i> Desde</label>
            <input type="date" id="histFilterDesde" onchange="filtrarHistorialVentas()" />
        </div>
        <div class="hist-filter-group">
            <label><i class="fa-regular fa-calendar"></i> Hasta</label>
            <input type="date" id="histFilterHasta" onchange="filtrarHistorialVentas()" />
        </div>
        <button onclick="limpiarFiltrosHistorial()" class="btn-limpiar-hist" title="Restablecer filtros">
            <i class="fa-solid fa-rotate-left"></i> Limpiar
        </button>
    </div>

    <!-- Tabla moderna del historial -->
    <div class="historial-table-card">
        <div class="historial-table-header">
            <div class="hist-header-title">
                <i class="fa-solid fa-receipt"></i> Registro de Ventas y Tickets
            </div>
            <div id="histCounterBadge" class="hist-counter-pill">
                @historialSalidas.Count ventas registradas
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table class="pos-table" id="tablaHistorialVentas">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Fecha y Hora</th>
                        <th>Artículos Vendidos</th>
                        <th>Método</th>
                        <th>Usuario / Cajero</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in historialSalidas)
                    {
                        var totalVenta = s.Total ?? s.Detallesalida.Sum(d => (decimal)(d.Cantidad * (d.PrecioUnitario ?? 0m)));
                        var folioStr = s.Folio ?? $"#{s.IdSalida:D6}";
                        var fechaStr = s.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "—";
                        var fechaIso = s.FechaCreacion?.ToString("yyyy-MM-dd") ?? "";
                        var cantTotal = s.Detallesalida.Sum(d => d.Cantidad);
                        var metodo = s.MetodoPago ?? "Efectivo";
                        var usuario = s.IdUsuarioCreoNavigation?.Nombre ?? "Recepción";

                        // Resumen de nombres de productos para filtro
                        var prodsTexto = string.Join(" ", s.Detallesalida.Select(d => d.IdProductoNavigation?.Nombre ?? "")).ToLower();

                        <tr class="hist-row"
                            data-folio="@folioStr.ToLower()"
                            data-prods="@prodsTexto"
                            data-metodo="@metodo"
                            data-fecha="@fechaIso">
                            <td>
                                <span class="folio-tag">@folioStr</span>
                            </td>
                            <td>
                                <div class="fecha-cell">
                                    <i class="fa-regular fa-calendar-days text-muted"></i>
                                    <span>@fechaStr</span>
                                </div>
                            </td>
                            <td>
                                <div class="items-summary-cell">
                                    <span class="items-count-badge">@cantTotal @(cantTotal == 1 ? "artículo" : "artículos")</span>
                                    <span class="items-names-sub" title="@string.Join(", ", s.Detallesalida.Select(d => $"{d.Cantidad}x {d.IdProductoNavigation?.Nombre}"))">
                                        @string.Join(", ", s.Detallesalida.Take(2).Select(d => $"{d.Cantidad}x {d.IdProductoNavigation?.Nombre}"))@(s.Detallesalida.Count > 2 ? "..." : "")
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (metodo == "Transferencia")
                                {
                                    <span class="metodo-badge metodo-transfer"><i class="fa-solid fa-building-columns"></i> Transferencia</span>
                                }
                                else if (metodo == "Tarjeta")
                                {
                                    <span class="metodo-badge metodo-tarjeta"><i class="fa-solid fa-credit-card"></i> Tarjeta</span>
                                }
                                else
                                {
                                    <span class="metodo-badge metodo-efectivo"><i class="fa-solid fa-money-bill-wave"></i> Efectivo</span>
                                }
                            </td>
                            <td>
                                <span class="usuario-cell"><i class="fa-regular fa-user"></i> @usuario</span>
                            </td>
                            <td style="text-align:right;">
                                <span class="total-cell text-green">$@totalVenta.ToString("N2")</span>
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex;align-items:center;justify-content:center;gap:6px;">
                                    <button onclick="verDetalleVenta(@s.IdSalida)" class="btn-ver-detalle" title="Ver detalle de ticket">
                                        <i class="fa-solid fa-eye"></i> Detalle
                                    </button>
                                    <button onclick="imprimirTicketDirecto(@s.IdSalida)" class="btn-table-print" title="Imprimir ticket en impresora POS">
                                        <i class="fa-solid fa-print"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!historialSalidas.Any())
                    {
                        <tr id="historialEmptyRow">
                            <td colspan="7" style="text-align:center;padding:48px 20px;color:var(--text-muted);">
                                <i class="fa-solid fa-receipt" style="font-size:36px;opacity:0.3;display:block;margin-bottom:12px;"></i>
                                Aún no hay ventas registradas en el sistema.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     MODAL 1: CHECKOUT / COBRAR VENTA
══════════════════════════════════════════════════════════════════════════ -->
<div id="modalCheckout" class="pos-modal-backdrop" style="display:none;">
    <div class="pos-modal-card checkout-modal-size">
        <div class="pos-modal-header">
            <div class="pos-modal-title">
                <i class="fa-solid fa-cash-register text-cyan"></i> Finalizar venta
            </div>
            <button onclick="cerrarModalCheckout()" class="pos-modal-close">✕</button>
        </div>

        <div class="pos-modal-body">
            <!-- Gran Total en Pantalla -->
            <div class="checkout-amount-display">
                <span class="checkout-amount-label">TOTAL A PAGAR</span>
                <span id="checkoutTotalDisplay" class="checkout-amount-number">$0.00</span>
                <span id="checkoutDiscountNote" class="checkout-amount-sub"></span>
            </div>

            <!-- Selector de Métodos de Pago -->
            <label class="checkout-section-label">Selecciona el método de pago:</label>
            <div class="payment-methods-grid">
                <button type="button" class="method-card active" data-method="Efectivo" onclick="seleccionarMetodoPago('Efectivo')">
                    <div class="method-card-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
                    <div class="method-card-title">Efectivo</div>
                    <div class="method-card-sub">Pago en caja</div>
                </button>

                <button type="button" class="method-card" data-method="Transferencia" onclick="seleccionarMetodoPago('Transferencia')">
                    <div class="method-card-icon"><i class="fa-solid fa-building-columns"></i></div>
                    <div class="method-card-title">Transferencia</div>
                    <div class="method-card-sub">SPEI / Banco</div>
                </button>

                <button type="button" class="method-card" data-method="Tarjeta" onclick="seleccionarMetodoPago('Tarjeta')">
                    <div class="method-card-icon"><i class="fa-solid fa-credit-card"></i></div>
                    <div class="method-card-title">Tarjeta</div>
                    <div class="method-card-sub">Terminal física</div>
                </button>
            </div>

            <!-- Formulario Específico: EFECTIVO -->
            <div id="formMetodoEfectivo" class="payment-method-details">
                <div class="efectivo-calculator-box">
                    <label class="pos-field-label">Efectivo recibido de cliente:</label>
                    <div class="input-currency-wrapper">
                        <span class="currency-symbol">$</span>
                        <input type="number" id="inputEfectivoRecibido" step="any" min="0" placeholder="0.00" oninput="calcularCambioEfectivo()" />
                    </div>

                    <!-- Botones rápidos de billetes comunes -->
                    <div class="quick-cash-row">
                        <button type="button" onclick="setEfectivoExacto()" class="btn-cash-quick">Exacto</button>
                        <button type="button" onclick="addEfectivoRecibido(50)" class="btn-cash-quick">$50</button>
                        <button type="button" onclick="addEfectivoRecibido(100)" class="btn-cash-quick">$100</button>
                        <button type="button" onclick="addEfectivoRecibido(200)" class="btn-cash-quick">$200</button>
                        <button type="button" onclick="addEfectivoRecibido(500)" class="btn-cash-quick">$500</button>
                        <button type="button" onclick="addEfectivoRecibido(1000)" class="btn-cash-quick">$1,000</button>
                    </div>

                    <!-- Resultado de Cambio -->
                    <div class="cambio-result-card" id="cambioBoxResult">
                        <span class="cambio-label">CAMBIO A DEVOLVER:</span>
                        <span id="displayCambioCalculado" class="cambio-number">$0.00</span>
                    </div>
                    <div id="efectivoErrorMsg" class="cash-insufficient-alert" style="display:none;">
                        <i class="fa-solid fa-circle-exclamation"></i> El importe recibido es insuficiente.
                    </div>
                </div>
            </div>

            <!-- Formulario Específico: TRANSFERENCIA -->
            <div id="formMetodoTransferencia" class="payment-method-details" style="display:none;">
                <div class="pos-field-group">
                    <label class="pos-field-label">Referencia / Folio de Operación:</label>
                    <input type="text" id="inputTransferReferencia" placeholder="Ej: SPEI-984210 o últimos dígitos de rastreo" />
                </div>
                <div class="pos-field-group">
                    <label class="pos-field-label">Banco o Notas adicionales (opcional):</label>
                    <input type="text" id="inputTransferNotas" placeholder="Ej: BBVA, Santander, comprobante verificado" />
                </div>
            </div>

            <!-- Formulario Específico: TARJETA -->
            <div id="formMetodoTarjeta" class="payment-method-details" style="display:none;">
                <div class="pos-field-group">
                    <label class="pos-field-label">Número de autorización o Referencia terminal (opcional):</label>
                    <input type="text" id="inputTarjetaReferencia" placeholder="Ej: AUT-54321 / Clip / Mercado Pago POS" />
                </div>
                <div class="pos-field-group">
                    <label class="pos-field-label">Notas adicionales:</label>
                    <input type="text" id="inputTarjetaNotas" placeholder="Ej: Tarjeta Débito / Crédito" />
                </div>
            </div>

            <div id="checkoutGlobalError" class="pos-error-box" style="display:none;"></div>
        </div>

        <div class="pos-modal-footer">
            <button type="button" onclick="cerrarModalCheckout()" class="btn-modal-cancel">Cancelar</button>
            <button type="button" id="btnConfirmarVentaFinal" onclick="procesarConfirmarVenta()" class="btn-modal-confirm">
                <i class="fa-solid fa-circle-check"></i> Confirmar venta
            </button>
        </div>
    </div>
</div>

