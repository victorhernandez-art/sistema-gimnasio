══════════════════════════════════════════════════════════════════════════ -->
<div id="modalProducto" class="pos-modal-backdrop" style="display:none;">
    <div class="pos-modal-card" style="max-width:540px;">
        <div class="pos-modal-header">
            <div class="pos-modal-title" id="modalProdTitulo">
                <i class="fa-solid fa-box text-cyan"></i> Nuevo Producto
            </div>
            <button onclick="cerrarModalProducto()" class="pos-modal-close">✕</button>
        </div>

        <div class="pos-modal-body">
            <input type="hidden" id="prodId" value="0" />

            <div class="pos-field-group">
                <label class="pos-field-label">Nombre del producto <span class="text-danger">*</span></label>
                <input id="prodNombre" type="text" placeholder="Ej: Proteína Whey 2Lb, Shaker 700ml..." />
            </div>

            <div class="pos-field-group">
                <label class="pos-field-label">Categoría</label>
                <select id="prodCategoria">
                    <option value="Suplemento">Suplementos</option>
                    <option value="Ropa">Ropa</option>
                    <option value="Equipo">Equipo</option>
                    <option value="Bebida">Bebidas</option>
                    <option value="Accesorio">Accesorios</option>
                    <option value="Otro" selected>Otros</option>
                </select>
            </div>

            <!-- Carga de Foto desde PC con Preview -->
            <div class="pos-field-group">
                <label class="pos-field-label">
                    <i class="fa-solid fa-camera text-cyan"></i> Foto real del producto (subir desde tu PC)
                </label>
                <div class="prod-photo-upload-zone" id="prodPhotoUploadZone">
                    <div class="photo-preview-wrap" id="photoPreviewWrap" style="display:none;">
                        <img id="prodPhotoImgPreview" src="" alt="Vista previa de foto" />
                        <div class="photo-preview-overlay">
                            <button type="button" class="btn-change-photo" onclick="event.stopPropagation(); document.getElementById('prodFotoFile').click()">
                                <i class="fa-solid fa-camera"></i> Cambiar foto
                            </button>
                            <button type="button" class="btn-remove-photo" onclick="event.stopPropagation(); quitarFotoSeleccionada()">
                                <i class="fa-solid fa-trash"></i> Quitar
                            </button>
                        </div>
                    </div>
                    <div class="photo-drop-prompt" id="photoDropPrompt" onclick="document.getElementById('prodFotoFile').click()">
                        <i class="fa-solid fa-cloud-arrow-up photo-upload-icon"></i>
                        <span class="photo-upload-title">Sube la foto real de tu producto</span>
                        <button type="button" class="btn-seleccionar-pc" onclick="event.stopPropagation(); document.getElementById('prodFotoFile').click()">
                            <i class="fa-solid fa-desktop"></i> Seleccionar foto de mi PC
                        </button>
                        <span class="photo-upload-sub">o arrastra tu imagen aquí &bull; PNG, JPG, JPEG o WEBP (máx. 5MB)</span>
                    </div>
                    <div id="photoFileNameBadge" class="photo-name-badge" style="display:none;"></div>
                    <input type="file" id="prodFotoFile" accept="image/png, image/jpeg, image/jpg, image/webp" style="display:none;" onchange="previewFotoProducto(this)" />
                    <input type="hidden" id="prodEliminarFoto" value="false" />
                </div>
            </div>

            <div class="pos-grid-2">
                <div class="pos-field-group">
                    <label class="pos-field-label">Precio de Venta <span class="text-danger">*</span></label>
                    <input id="prodPrecio" type="number" min="0" step="0.01" placeholder="Ej: 350.00" />
                </div>
                <div class="pos-field-group">
                    <label class="pos-field-label">Costo unitario (opcional)</label>
                    <input id="prodCosto" type="number" min="0" step="0.01" placeholder="Ej: 200.00" />
                </div>
            </div>

            <div class="pos-grid-2">
                <div class="pos-field-group">
                    <label class="pos-field-label">Stock inicial</label>
                    <input id="prodStock" type="number" min="0" placeholder="0" />
                </div>
                <div class="pos-field-group">
                    <label class="pos-field-label">Stock mínimo (alerta)</label>
                    <input id="prodStockMin" type="number" min="0" placeholder="5" value="5" />
                </div>
            </div>

            <div class="pos-field-group">
                <label class="pos-field-label">Descripción</label>
                <textarea id="prodDescripcion" rows="2" placeholder="Detalles, sabor, tallas o especificaciones..."></textarea>
            </div>

            <div id="modalProdMsg" class="pos-error-box" style="display:none;"></div>
        </div>

        <div class="pos-modal-footer">
            <button onclick="cerrarModalProducto()" class="btn-modal-cancel">Cancelar</button>
            <button onclick="guardarProducto()" class="btn-modal-confirm">
                <i class="fa-solid fa-floppy-disk"></i> Guardar Producto
            </button>
        </div>
    </div>
</div>

