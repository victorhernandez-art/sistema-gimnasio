<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Sistema Gimnasio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/gym.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#00f2ff" />
    <script>
        (function() {
            var theme = localStorage.getItem('gym_theme') || 'cyan';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    @if (GymWeb.Helpers.AppSettings.HasCustomBg)
    {
        <style>body::before { background-image: url('/img/fondo-custom.jpg'); }</style>
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@if (Context.Session.GetString("UsuarioId") != null)
{
    var topbarLic = GymWeb.Helpers.LicenseService.GetStatus();
    bool licBloqueada = topbarLic.IsTrialExpired;
    bool primerUso = topbarLic.IsFirstInstall;
    bool licInvalida = !topbarLic.Valid;

    <!-- Sidebar -->
    <nav id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                @if (GymWeb.Helpers.AppSettings.HasCustomLogo)
                {
                    <img src="/img/logo-custom.png?v=@DateTime.Now.Ticks" alt="Logo" class="sidebar-custom-logo" />
                }
                else
                {
                    <i class="fa-solid fa-dumbbell"></i>
                }
                <span class="sidebar-title">@GymWeb.Helpers.AppSettings.GymNombre</span>
            </div>
            <button id="sidebarToggle" class="sidebar-toggle" title="Colapsar menú">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar"><i class="fa-solid fa-user"></i></div>
            <div class="user-info">
                <span class="user-name">@Context.Session.GetString("UsuarioNombre")</span>
                <span class="user-role">@(Context.Session.GetString("UsuarioRol") == "superadmin" ? "Super Administrador" : "Administrador")</span>
            </div>
        </div>

        <ul class="sidebar-nav">
            <li class="nav-section-label">Principal</li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Home/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Dashboard"))">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            <li class="nav-section-label">Gestión</li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Socios/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Socios" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Socios"))">
                    <i class="fa-solid fa-users"></i>
                    <span>Socios</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Membresias/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Membresias" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Membresías"))">
                    <i class="fa-solid fa-id-card"></i>
                    <span>Membresías</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Pagos/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pagos" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Pagos"))">
                    <i class="fa-solid fa-dollar-sign"></i>
                    <span>Pagos</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Registro/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Registro" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Registro de Visitas"))">
                    <i class="fa-solid fa-clipboard-list"></i>
                    <span>Registro de Visitas</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            <li class="nav-section-label">Comercial</li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Productos/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Tienda / Ventas"))">
                    <i class="fa-solid fa-store"></i>
                    <span>Tienda / Ventas</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            <li class="nav-section-label">Sistema</li>
            <li>
                <a href="@(licInvalida ? "/Configuracion/Index?tab=licencia" : "/Reportes/Index")"
                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "") @(licBloqueada ? "sidebar-locked-nav" : "")"
                   title="@(licBloqueada ? "Módulo bloqueado: Requiere activación de Licencia Vitalicia" : (primerUso ? "Activa tu prueba gratuita de 7 días" : "Reportes"))">
                    <i class="fa-solid fa-chart-bar"></i>
                    <span>Reportes</span>
                    @if (licBloqueada) { <i class="fa-solid fa-lock" style="font-size:11px;margin-left:auto;color:#ef4444;" title="Bloqueado por fin de prueba"></i> }
                </a>
            </li>
            @if (Context.Session.GetString("UsuarioRol") == "superadmin" || licInvalida)
            {
                if (Context.Session.GetString("UsuarioRol") == "superadmin" && !licInvalida)
                {
                    <li>
                        <a asp-controller="Usuarios" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")">
                            <i class="fa-solid fa-user-gear"></i>
                            <span>Usuarios</span>
                        </a>
                    </li>
                }
                <li>
                    <a href="/Configuracion/Index?tab=licencia" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracion" ? "active" : "") @(licBloqueada ? "sidebar-lic-active-btn" : "")"
                       style="@(licBloqueada ? "background:rgba(239,68,68,0.12);border:1px solid #ef4444;color:#ef4444;font-weight:700;" : (primerUso ? "background:rgba(0,242,255,0.12);border:1px solid #00f2ff;color:#00f2ff;font-weight:700;" : ""))">
                        <i class="fa-solid @(licBloqueada ? "fa-key" : (primerUso ? "fa-circle-check" : "fa-gear"))"></i>
                        <span>@(licBloqueada ? "Activar Licencia" : (primerUso ? "Activar Prueba" : "Configuración"))</span>
                    </a>
                </li>
                if (Context.Session.GetString("UsuarioRol") == "superadmin" && !licInvalida)
                {
                    <li>
                        <a asp-controller="Backup" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Backup" ? "active" : "")">
                            <i class="fa-solid fa-database"></i>
                            <span>Respaldo</span>
                        </a>
                    </li>
                }
            }
        </ul>

        <div class="sidebar-footer">
            <a asp-controller="Account" asp-action="Logout" class="nav-link logout-link">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Cerrar Sesión</span>
            </a>
            <div class="sidebar-version" style="cursor:pointer;" onclick="window.gymForzarVerificarActualizacion && window.gymForzarVerificarActualizacion(true)" title="Buscar actualizaciones de GymWeb">
                <span>Versión @GymWeb.Helpers.AppSettings.CurrentVersion</span> <i class="fa-solid fa-arrows-rotate" style="font-size:10px;margin-left:4px;opacity:0.6;"></i>
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <div id="mainContent" class="main-content">
        @if (licBloqueada)
        {
            <div style="background:linear-gradient(90deg, #dc2626, #991b1b);color:#ffffff;padding:12px 20px;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:14px;box-shadow:0 4px 14px rgba(220,38,38,0.4);position:relative;z-index:100;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <i class="fa-solid fa-lock" style="font-size:18px;color:#fca5a5;"></i>
                    <span><strong>Periodo de prueba finalizado:</strong> Tus datos están 100% seguros y respaldados. Activa tu licencia vitalicia para continuar usando todos los módulos.</span>
                </div>
                <a href="/Configuracion/Index?tab=licencia" class="btn btn-sm" style="background:#ffffff;color:#991b1b;font-weight:800;white-space:nowrap;padding:6px 14px;border-radius:8px;text-decoration:none;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
                    <i class="fa-solid fa-key"></i> Activar Licencia Ahora
                </a>
            </div>
        }
        else if (primerUso)
        {
            <div style="background:linear-gradient(90deg, #0284c7, #0369a1);color:#ffffff;padding:12px 20px;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:14px;box-shadow:0 4px 14px rgba(2,132,199,0.35);position:relative;z-index:100;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <i class="fa-solid fa-circle-info" style="font-size:18px;color:#7dd3fc;"></i>
                    <span><strong>Bienvenido a GymPro:</strong> Dispones de 7 días de prueba completa sin restricciones.</span>
                </div>
                <a href="/Configuracion/Index?tab=licencia" class="btn btn-sm" style="background:#ffffff;color:#0369a1;font-weight:800;white-space:nowrap;padding:6px 14px;border-radius:8px;text-decoration:none;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
                    <i class="fa-solid fa-circle-check"></i> Activar Prueba Gratuita
                </a>
            </div>
        }
        else if (topbarLic.IsTrialActive && topbarLic.DaysLeft <= 1)
        {
            <div style="background:linear-gradient(90deg, #ea580c, #c2410c);color:#ffffff;padding:12px 20px;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:14px;box-shadow:0 4px 14px rgba(234,88,12,0.35);position:relative;z-index:100;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <i class="fa-solid fa-hourglass-end" style="font-size:18px;color:#fed7aa;"></i>
                    <span><strong>Último día de prueba gratuita:</strong> Activa tu licencia para seguir usando GymPro sin interrupciones.</span>
                </div>
                <a href="/Configuracion/Index?tab=licencia" class="btn btn-sm" style="background:#ffffff;color:#c2410c;font-weight:800;white-space:nowrap;padding:6px 14px;border-radius:8px;text-decoration:none;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
                    <i class="fa-solid fa-key"></i> Activar Licencia
                </a>
            </div>
        }
        else if (topbarLic.IsTrialActive && topbarLic.DaysLeft <= 3)
        {
            <div style="background:linear-gradient(90deg, #d97706, #b45309);color:#ffffff;padding:12px 20px;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:14px;box-shadow:0 4px 14px rgba(217,119,6,0.35);position:relative;z-index:100;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <i class="fa-solid fa-clock" style="font-size:18px;color:#fde68a;"></i>
                    <span><strong>Aviso de Prueba:</strong> Te quedan @topbarLic.DaysLeft días de prueba gratuita. Adquiere tu licencia para no perder el acceso a tus funciones.</span>
                </div>
                <a href="/Configuracion/Index?tab=licencia" class="btn btn-sm" style="background:#ffffff;color:#b45309;font-weight:800;white-space:nowrap;padding:6px 14px;border-radius:8px;text-decoration:none;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
                    <i class="fa-solid fa-key"></i> Activar Licencia
                </a>
            </div>
        }
        <header class="topbar">
            <button id="mobileMenuBtn" class="mobile-menu-btn">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="topbar-title">
                @ViewData["Title"]
                @{
                    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                    var tipTexts = new Dictionary<string, string> {
                        ["Home"]         = "Resumen general del gimnasio: socios activos, membresías próximas a vencer, ingresos del día y últimas actividades registradas.",
                        ["Socios"]       = "Alta y gestión de miembros. Registra socios con foto, asigna membresías, consulta historial de asistencia y controla bajas.",
                        ["Membresias"]   = "Define los planes de acceso disponibles: visita de día, semana, quincena o mes. Configura nombre, duración en días y precio de cada plan.",
                        ["Registro"]     = "Control de acceso diario. Ingresa el ID del socio para registrar su entrada, o registra visitantes de un día con cobro automático según el plan Visita.",
                        ["Productos"]    = "Inventario de productos: agrega, edita, controla stock y registra ventas rápidas desde una sola pantalla.",
                        ["Reportes"]     = "Corte del día (ingresos por visitas y ventas) e historial de asistencias por periodo.",
                        ["Usuarios"]     = "Administra las cuentas de acceso al sistema. Crea, edita o desactiva usuarios y gestiona sus contraseñas.",
                    };
                    if (ctrl != null && tipTexts.TryGetValue(ctrl, out var tipText))
                    {
                        <i class="fa-solid fa-circle-info topbar-tip" data-tip="@tipText"></i>
                    }
                }
            </div>
            <div class="topbar-actions">
                <!-- License Status Badge -->
                <a href="/Configuracion/Index?tab=licencia" class="topbar-license-badge @(topbarLic.IsLifetime ? "vitalicia" : (topbarLic.IsTrialActive ? (topbarLic.DaysLeft <= 3 ? "trial-orange" : "trial-green") : (primerUso ? "trial-blue" : "demo")))" title="Estado de la Licencia (Clic para gestionar)">
                    @if (topbarLic.IsLifetime)
                    {
                        <span class="license-dot green"></span>
                        <span>LICENCIA VITALICIA</span>
                    }
                    else if (topbarLic.IsTrialActive)
                    {
                        <span class="license-dot @(topbarLic.DaysLeft <= 3 ? "orange" : "green")"></span>
                        <span>PRUEBA GRATUITA (@topbarLic.DaysLeft DÍAS)</span>
                    }
                    else if (primerUso)
                    {
                        <span class="license-dot blue"></span>
                        <span>PRUEBA GRATUITA (7 DÍAS)</span>
                    }
                    else
                    {
                        <span class="license-dot red"></span>
                        <span>PRUEBA FINALIZADA</span>
                    }
                </a>

                <!-- Theme Palette Selector -->
                <div class="theme-palette-wrapper" id="themePaletteWrapper">
                    <button type="button" class="theme-palette-btn" id="themePaletteBtn" title="Cambiar color del tema">
                        <i class="fa-solid fa-palette"></i>
                    </button>
                    <div class="theme-palette-dropdown" id="themePaletteDropdown">
                        <div class="theme-palette-title"><i class="fa-solid fa-palette"></i> Color del Sistema</div>
                        <div class="theme-colors-grid">
                            <button type="button" class="theme-color-opt" data-color="cyan" title="Cian Neón" style="--swatch:#00f2ff;"></button>
                            <button type="button" class="theme-color-opt" data-color="emerald" title="Verde Esmeralda" style="--swatch:#10b981;"></button>
                            <button type="button" class="theme-color-opt" data-color="orange" title="Naranja Fuego" style="--swatch:#f97316;"></button>
                            <button type="button" class="theme-color-opt" data-color="purple" title="Púrpura Eléctrico" style="--swatch:#a855f7;"></button>
                            <button type="button" class="theme-color-opt" data-color="red" title="Rojo Adrenalina" style="--swatch:#ef4444;"></button>
                            <button type="button" class="theme-color-opt" data-color="gold" title="Oro Deportivo" style="--swatch:#eab308;"></button>
                        </div>
                    </div>
                </div>

                <span class="topbar-user">
                    <i class="fa-solid fa-circle-user"></i>
                    @Context.Session.GetString("UsuarioNombre")
                </span>
            </div>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>
}
else
{
    @RenderBody()
}

<div id="navTip" class="nav-tip-popup"></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/gym.js" asp-append-version="true"></script>

@if (Context.Session.GetString("UsuarioId") != null)
{
<script>
// ── Cierre autom\u00e1tico por inactividad (55 min aviso, 60 min logout) ──
(function(){
    const WARN_MS   = 55 * 60 * 1000;
    const LOGOUT_MS = 60 * 60 * 1000;
    let warnTimer, logoutTimer;
    const events = ['mousemove','keydown','mousedown','touchstart','scroll'];

    function resetTimers() {
        clearTimeout(warnTimer);
        clearTimeout(logoutTimer);
        document.getElementById('sessionWarnBox').style.display = 'none';
        warnTimer   = setTimeout(showWarn,   WARN_MS);
        logoutTimer = setTimeout(doLogout,   LOGOUT_MS);
    }

    function showWarn() {
        document.getElementById('sessionWarnBox').style.display = 'flex';
        let s = 300;
        const cd = document.getElementById('sessionCountdown');
        cd.textContent = s;
        const t = setInterval(() => { s--; cd.textContent = s; if(s<=0) clearInterval(t); }, 1000);
    }

    function doLogout() {
        window.location.href = '/Account/Logout';
    }

    events.forEach(ev => document.addEventListener(ev, resetTimers, { passive:true }));
    resetTimers();
})();
</script>

<!-- Aviso inactividad -->
<div id="sessionWarnBox" style="display:none;position:fixed;bottom:24px;right:24px;z-index:99999;background:#1a1b2e;border:1px solid rgba(251,191,36,0.5);border-radius:14px;padding:18px 24px;box-shadow:0 8px 32px rgba(0,0,0,0.6);max-width:320px;align-items:flex-start;gap:14px;">
    <div style="font-size:22px;color:#fbbf24;"><i class="fa-solid fa-clock"></i></div>
    <div>
        <div style="font-weight:600;color:#fbbf24;margin-bottom:4px;">Sesi\u00f3n por expirar</div>
        <div style="font-size:13px;color:var(--text-muted);">La sesi\u00f3n cerrar\u00e1 en <strong id="sessionCountdown" style="color:#fbbf24;">300</strong> segundos por inactividad.</div>
        <div style="margin-top:10px;display:flex;gap:8px;">
            <button onclick="(function(){document.getElementById('sessionWarnBox').style.display='none';document.dispatchEvent(new Event('mousemove'));})()" class="btn btn-sm" style="background:rgba(251,191,36,0.2);color:#fbbf24;border:1px solid rgba(251,191,36,0.4);">
                Seguir aqu\u00ed
            </button>
            <a href="/Account/Logout" class="btn btn-sm btn-outline">Cerrar sesi\u00f3n</a>
        </div>
    </div>
</div>

@* ── Modal de Actualización Automática In-App (Auto-Updater en 1 Clic) ── *@
@if ((Context.Session.GetString("UsuarioRol") == "superadmin" || Context.Session.GetString("UsuarioRol") == "admin") && GymWeb.Helpers.LicenseService.GetStatus().Valid)
{
<!-- Backdrop del modal -->
<div id="updateBackdrop" style="display:none;position:fixed;inset:0;background:rgba(5,10,20,0.78);backdrop-filter:blur(6px);z-index:99990;"></div>

<!-- Modal de Actualización -->
<div id="updateModal" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(0.92);z-index:99999;width:min(540px,94vw);background:linear-gradient(165deg,#0a101f 0%,#0f172a 100%);border:1px solid rgba(0,242,255,0.25);border-radius:22px;box-shadow:0 28px 70px rgba(0,0,0,0.85), 0 0 40px rgba(0,242,255,0.08);overflow:hidden;opacity:0;transition:opacity 0.28s ease, transform 0.28s cubic-bezier(0.34,1.56,0.64,1);color:#ffffff;font-family:inherit;">
    
    <!-- Barra superior con degradado dinámico -->
    <div style="height:4px;background:linear-gradient(90deg,#00f2ff,#3b82f6,#8b5cf6,#00f2ff);background-size:200% 100%;animation:gymUpdateShimmer 3s linear infinite;"></div>

    <!-- Header del Modal -->
    <div style="padding:18px 22px 14px;display:flex;align-items:flex-start;justify-content:space-between;gap:14px;border-bottom:1px solid rgba(255,255,255,0.07);">
        <div style="display:flex;align-items:center;gap:14px;">
            <div id="upHeaderIconBox" style="width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,rgba(0,242,255,0.18),rgba(59,130,246,0.12));border:1px solid rgba(0,242,255,0.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(0,242,255,0.2);">
                <i id="upHeaderIcon" class="fa-solid fa-rocket" style="color:#00f2ff;font-size:21px;"></i>
            </div>
            <div>
                <div id="upHeaderTitle" style="font-size:16px;font-weight:700;color:#ffffff;letter-spacing:0.2px;">Nueva Actualización Disponible</div>
                <div style="display:flex;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap;">
                    <span style="font-size:11.5px;padding:2px 8px;border-radius:6px;background:rgba(0,242,255,0.15);border:1px solid rgba(0,242,255,0.35);color:#00f2ff;font-weight:700;" id="upLatestBadge">v2.5</span>
                    <span style="font-size:11.5px;color:#64748b;">actual: <span id="upCurrent" style="color:#94a3b8;font-weight:600;">v2.4</span></span>
                    <span id="upSizeBadge" style="font-size:11px;padding:2px 7px;border-radius:6px;background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.3);color:#c4b5fd;">Tamaño: ~2.4 MB</span>
                </div>
            </div>
        </div>
        <button id="upCloseBtn" onclick="gymDismissUpdate('later')" style="background:none;border:none;color:#64748b;cursor:pointer;font-size:22px;line-height:1;padding:4px;flex-shrink:0;transition:color 0.15s;" title="Cerrar">&times;</button>
    </div>

    <!-- ═══ VISTA 1: INFORMACIÓN Y NOTAS DE VERSIÓN ═══ -->
    <div id="upViewInfo" style="padding:18px 22px;">
        <div style="max-height:48vh;overflow-y:auto;padding-right:4px;">
            <!-- Novedades -->
            <div id="upNovedadesSection" style="margin-bottom:14px;">
                <div style="font-size:11px;font-weight:700;color:#00f2ff;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
                    <i class="fa-solid fa-sparkles"></i> NOVEDADES
                </div>
                <div id="upNovedadesList" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:12px 14px;font-size:12.5px;color:#cbd5e1;line-height:1.6;display:flex;flex-direction:column;gap:7px;">
                </div>
            </div>

            <!-- Correcciones -->
            <div id="upCorreccionesSection" style="margin-bottom:14px;display:none;">
                <div style="font-size:11px;font-weight:700;color:#38bdf8;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
                    <i class="fa-solid fa-wrench"></i> CORRECCIONES Y MEJORAS
                </div>
                <div id="upCorreccionesList" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:12px 14px;font-size:12.5px;color:#cbd5e1;line-height:1.6;display:flex;flex-direction:column;gap:7px;">
                </div>
            </div>

            <!-- Aviso de Seguridad / Protección de Datos -->
            <div style="display:flex;align-items:center;gap:10px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.22);border-radius:10px;padding:10px 14px;">
                <i class="fa-solid fa-shield-check" style="color:#10b981;font-size:16px;flex-shrink:0;"></i>
                <span style="font-size:12px;color:#6ee7b7;line-height:1.4;">
                    Tus socios, cobros, base de datos y configuración <strong>se mantienen 100% seguros</strong>. El actualizador solo renueva el código y optimizaciones.
                </span>
            </div>
        </div>

        <!-- Botones de Acción de Vista 1 -->
        <div style="margin-top:18px;display:flex;gap:10px;justify-content:flex-end;border-top:1px solid rgba(255,255,255,0.07);padding-top:16px;">
            <button onclick="gymDismissUpdate('later')" style="padding:9px 18px;border-radius:10px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.05);color:#94a3b8;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.15s;">
                <i class="fa-regular fa-clock" style="margin-right:5px;"></i> Más tarde (Omitir)
            </button>
            <button id="upBtnActualizarAhora" onclick="gymIniciarActualizacion()" style="display:inline-flex;align-items:center;gap:8px;padding:9px 22px;border-radius:10px;border:none;background:linear-gradient(135deg,#00f2ff,#0284c7);color:#031326;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 18px rgba(0,242,255,0.35);transition:all 0.15s;">
                <i class="fa-solid fa-bolt"></i> Actualizar Ahora
            </button>
        </div>
    </div>

    <!-- ═══ VISTA 2: DESCARGA CON BARRA DE PROGRESO EN VIVO ═══ -->
    <div id="upViewProgress" style="display:none;padding:24px 22px;">
        <div style="text-align:center;margin-bottom:18px;">
            <div style="font-size:15px;font-weight:700;color:#ffffff;margin-bottom:4px;" id="upProgressTitle">
                Descargando actualización...
            </div>
            <div style="font-size:12.5px;color:#94a3b8;" id="upProgressSubtitle">
                Por favor espera mientras descargamos los nuevos archivos del sistema.
            </div>
        </div>

        <!-- Pista de la Barra de Progreso -->
        <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:12px;height:14px;overflow:hidden;position:relative;margin-bottom:12px;">
            <div id="upProgressBar" style="height:100%;width:0%;border-radius:12px;background:linear-gradient(90deg,#00f2ff,#0284c7,#6366f1);transition:width 0.3s ease;position:relative;overflow:hidden;">
                <div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent);animation:gymUpdateBarShine 1.5s infinite;"></div>
            </div>
        </div>

        <!-- Métricas: Porcentaje, Bytes y Velocidad -->
        <div style="display:flex;justify-content:space-between;align-items:center;font-size:12.5px;margin-bottom:18px;">
            <div>
                <span id="upPercentText" style="font-weight:700;color:#00f2ff;">0%</span>
                <span style="color:#64748b;margin:0 4px;">·</span>
                <span id="upBytesText" style="color:#cbd5e1;">0 KB / 0 KB</span>
            </div>
            <div>
                <span id="upSpeedText" style="color:#a78bfa;font-weight:600;font-family:monospace;">0 KB/s</span>
            </div>
        </div>

        <!-- Alerta Amarilla de Advertencia -->
        <div style="display:flex;align-items:center;gap:10px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:10px;padding:10px 14px;margin-bottom:18px;">
            <i class="fa-solid fa-triangle-exclamation" style="color:#f59e0b;font-size:15px;flex-shrink:0;"></i>
            <span style="font-size:12px;color:#fde68a;">
                Si cierras la aplicación o el navegador la descarga se interrumpirá.
            </span>
        </div>

        <!-- Botón de Cancelar -->
        <div style="display:flex;justify-content:center;">
            <button id="upBtnCancelar" onclick="gymCancelarActualizacion()" style="padding:8px 20px;border-radius:10px;border:1px solid rgba(239,68,68,0.3);background:rgba(239,68,68,0.08);color:#fca5a5;font-size:12.5px;font-weight:600;cursor:pointer;transition:all 0.15s;">
                <i class="fa-solid fa-xmark" style="margin-right:5px;"></i> Cancelar descarga
            </button>
        </div>
    </div>

    <!-- ═══ VISTA 3: APLICANDO Y REINICIANDO SISTEMA ═══ -->
    <div id="upViewInstalling" style="display:none;padding:32px 22px;text-align:center;">
        <div style="width:58px;height:58px;margin:0 auto 16px;border-radius:50%;background:rgba(0,242,255,0.12);border:2px solid #00f2ff;display:flex;align-items:center;justify-content:center;box-shadow:0 0 24px rgba(0,242,255,0.35);">
            <i class="fa-solid fa-arrows-rotate fa-spin" style="color:#00f2ff;font-size:26px;"></i>
        </div>
        <div style="font-size:16px;font-weight:700;color:#ffffff;margin-bottom:6px;">
            Aplicando actualización en caliente...
        </div>
        <div style="font-size:13px;color:#94a3b8;line-height:1.5;max-width:380px;margin:0 auto 16px;">
            Descomprimiendo archivos y aplicando reemplazo. GymWeb se reiniciará automáticamente.
        </div>
        <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:20px;background:rgba(0,242,255,0.08);border:1px solid rgba(0,242,255,0.25);font-size:12px;color:#38bdf8;">
            <i class="fa-solid fa-circle-notch fa-spin"></i>
            <span id="upInstallStatusText">Reconectando con el sistema...</span>
        </div>
    </div>

    <!-- ═══ VISTA 4: ÉXITO Y RECARGA ═══ -->
    <div id="upViewSuccess" style="display:none;padding:34px 22px;text-align:center;">
        <div style="width:60px;height:60px;margin:0 auto 16px;border-radius:50%;background:rgba(16,185,129,0.15);border:2px solid #10b981;display:flex;align-items:center;justify-content:center;box-shadow:0 0 28px rgba(16,185,129,0.4);">
            <i class="fa-solid fa-check" style="color:#10b981;font-size:30px;"></i>
        </div>
        <div style="font-size:17px;font-weight:700;color:#ffffff;margin-bottom:6px;">
            ¡Actualización completada al 100%!
        </div>
        <div style="font-size:13px;color:#94a3b8;margin-bottom:6px;">
            El sistema se ha actualizado con éxito a la versión <strong id="upSuccessVersion" style="color:#10b981;"></strong>.
        </div>
        <div style="font-size:12px;color:#64748b;">
            Recargando pantalla...
        </div>
    </div>
</div>

<style>
@@keyframes gymFadeInBackdrop { from{opacity:0} to{opacity:1} }
@@keyframes gymUpdateShimmer { 0%{background-position:0% 0%} 100%{background-position:200% 0%} }
@@keyframes gymUpdateBarShine { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }
</style>

<script>
(function(){
    const SESSION_KEY = 'gym_update_checked';
    const DISMISS_KEY = 'gym_update_dismissed';
    let pollInterval = null;
    let pingInterval = null;
    let newVersionTag = '';

    // Limpiar dismiss huérfano (sin fecha) o expirado (24h)
    const exp = localStorage.getItem('gym_update_dismissed_exp');
    if (!exp || isNaN(Date.parse(exp)) || new Date() > new Date(exp)) {
        localStorage.removeItem(DISMISS_KEY);
        localStorage.removeItem('gym_update_dismissed_exp');
    }

    async function verificarActualizaciones(manual = false) {
        if (!manual && sessionStorage.getItem(SESSION_KEY) === 'shown') return;

        if (manual && window.mostrarToastNotificacion) {
            window.mostrarToastNotificacion('🔍 Buscando actualizaciones en GitHub...', 'info');
        }

        try {
            const res = await fetch('/Home/CheckUpdate');
            if (!res.ok) {
                if (manual && window.mostrarToastNotificacion) window.mostrarToastNotificacion('⚠️ No se pudo conectar con el servidor de actualizaciones.', 'warning');
                return;
            }
            const data = await res.json();
            if (!data.hasUpdate) {
                if (manual && window.mostrarToastNotificacion) {
                    window.mostrarToastNotificacion('✓ Tu sistema está actualizado a la versión más reciente (' + (data.current || 'actual') + ').', 'success');
                }
                return;
            }

            newVersionTag = data.latest;
            const dismissed = localStorage.getItem(DISMISS_KEY);
            if (!manual && dismissed === data.latest) return;

            // Llenar información en modal
            document.getElementById('upCurrent').textContent     = data.current || '';
            document.getElementById('upLatestBadge').textContent = data.latest || '';
            if (document.getElementById('upSuccessVersion')) {
                document.getElementById('upSuccessVersion').textContent = data.latest || '';
            }

            if (data.assetSizeFormatted) {
                document.getElementById('upSizeBadge').textContent = 'Tamaño: ' + data.assetSizeFormatted;
            }

            // Renderizar novedades
            const novList = document.getElementById('upNovedadesList');
            novList.innerHTML = '';
            const novedades = (data.novedades && data.novedades.length) ? data.novedades : (data.releaseNotes ? [data.releaseNotes] : ['Mejoras de rendimiento y estabilidad del sistema.']);
            novedades.forEach(function(item){
                const row = document.createElement('div');
                row.style.display = 'flex';
                row.style.alignItems = 'flex-start';
                row.style.gap = '8px';
                row.innerHTML = '<i class="fa-solid fa-circle-check" style="color:#00f2ff;font-size:11px;margin-top:4px;flex-shrink:0;"></i><span>' + escapeHtml(item) + '</span>';
                novList.appendChild(row);
            });

            // Renderizar correcciones
            const corrSec = document.getElementById('upCorreccionesSection');
            const corrList = document.getElementById('upCorreccionesList');
            if (data.correcciones && data.correcciones.length) {
                corrList.innerHTML = '';
                data.correcciones.forEach(function(item){
                    const row = document.createElement('div');
                    row.style.display = 'flex';
                    row.style.alignItems = 'flex-start';
                    row.style.gap = '8px';
                    row.innerHTML = '<i class="fa-solid fa-wrench" style="color:#38bdf8;font-size:11px;margin-top:4px;flex-shrink:0;"></i><span>' + escapeHtml(item) + '</span>';
                    corrList.appendChild(row);
                });
                corrSec.style.display = 'block';
            } else {
                corrSec.style.display = 'none';
            }

            // Asegurar que la vista de info esté visible y las otras ocultas
            document.getElementById('upViewInfo').style.display       = 'block';
            document.getElementById('upViewProgress').style.display   = 'none';
            document.getElementById('upViewInstalling').style.display = 'none';
            document.getElementById('upViewSuccess').style.display    = 'none';
            document.getElementById('upCloseBtn').style.display        = 'block';
            const btn = document.getElementById('upBtnActualizarAhora');
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Actualizar Ahora'; }

            // Mostrar modal suavemente
            const backdrop = document.getElementById('updateBackdrop');
            const modal    = document.getElementById('updateModal');
            backdrop.style.display = 'block';
            modal.style.display    = 'block';
            requestAnimationFrame(function(){
                requestAnimationFrame(function(){
                    backdrop.style.animation = 'gymFadeInBackdrop 0.25s ease forwards';
                    modal.style.opacity      = '1';
                    modal.style.transform    = 'translate(-50%,-50%) scale(1)';
                });
            });

            localStorage.setItem(DISMISS_KEY + '_seen', data.latest);
            sessionStorage.setItem(SESSION_KEY, 'shown');
        } catch(e) {
            if (manual && window.mostrarToastNotificacion) window.mostrarToastNotificacion('⚠️ Error al buscar actualizaciones.', 'warning');
        }
    }

    window.gymForzarVerificarActualizacion = function(manual = true) {
        verificarActualizaciones(manual);
    };

    // Auto-ejecución silenciosa a los 2.8 segundos
    setTimeout(function(){
        verificarActualizaciones(false);
    }, 2800);

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Cerrar u omitir actualización
    window.gymDismissUpdate = function(reason) {
        if (pollInterval) clearInterval(pollInterval);
        const backdrop = document.getElementById('updateBackdrop');
        const modal    = document.getElementById('updateModal');
        if (modal) {
            modal.style.opacity   = '0';
            modal.style.transform = 'translate(-50%,-50%) scale(0.92)';
            setTimeout(function(){ modal.style.display = 'none'; backdrop.style.display = 'none'; }, 260);
        }
        if (reason === 'later' && newVersionTag) {
            const expiry = new Date();
            expiry.setHours(expiry.getHours() + 24);
            localStorage.setItem(DISMISS_KEY, newVersionTag);
            localStorage.setItem('gym_update_dismissed_exp', expiry.toISOString());
        }
    };

    // Iniciar Actualización en 1 Clic
    window.gymIniciarActualizacion = async function() {
        const btn = document.getElementById('upBtnActualizarAhora');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Conectando...';
        }

        try {
            const res = await fetch('/Home/IniciarActualizacion', { method: 'POST' });
            const data = await res.json();
            if (!data.ok) {
                alert(data.msg || 'No se pudo iniciar la actualización.');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Actualizar Ahora'; }
                return;
            }

            // Cambiar vista a Progreso
            document.getElementById('upViewInfo').style.display     = 'none';
            document.getElementById('upViewProgress').style.display = 'block';
            document.getElementById('upCloseBtn').style.display      = 'none';

            // Comenzar sondeo de progreso cada 350ms
            pollInterval = setInterval(verificarProgreso, 350);
        } catch(err) {
            alert('Error de conexión al iniciar actualización: ' + err.message);
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Actualizar Ahora'; }
        }
    };

    async function verificarProgreso() {
        try {
            const res = await fetch('/Home/ProgresoActualizacion');
            if (!res.ok) return;
            const p = await res.json();

            const bar     = document.getElementById('upProgressBar');
            const pctText = document.getElementById('upPercentText');
            const bytText = document.getElementById('upBytesText');
            const spdText = document.getElementById('upSpeedText');

            if (p.percent !== undefined) {
                bar.style.width   = p.percent + '%';
                pctText.textContent = p.percent + '%';
            }
            if (p.downloadedFormatted && p.totalFormatted) {
                bytText.textContent = p.downloadedFormatted + ' / ' + p.totalFormatted;
            }
            if (p.speedText) {
                spdText.textContent = p.speedText;
            }

            if (p.status === 'extracting' || p.status === 'installing') {
                document.getElementById('upViewProgress').style.display   = 'none';
                document.getElementById('upViewInstalling').style.display = 'block';
                if (p.message) {
                    document.getElementById('upInstallStatusText').textContent = p.message;
                }
            }
            else if (p.status === 'ready') {
                clearInterval(pollInterval);
                document.getElementById('upViewProgress').style.display   = 'none';
                document.getElementById('upViewInstalling').style.display = 'none';
                document.getElementById('upViewSuccess').style.display    = 'block';

                // Iniciar ping hasta que el servidor reinicie y responda
                iniciarPingReconexion();
            }
            else if (p.status === 'error') {
                clearInterval(pollInterval);
                alert('Ocurrió un error durante la actualización: ' + (p.error || p.message));
                document.getElementById('upViewProgress').style.display = 'none';
                document.getElementById('upViewInfo').style.display     = 'block';
                document.getElementById('upCloseBtn').style.display      = 'block';
                const btn = document.getElementById('upBtnActualizarAhora');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Actualizar Ahora'; }
            }
            else if (p.status === 'cancelled') {
                clearInterval(pollInterval);
                document.getElementById('upViewProgress').style.display = 'none';
                document.getElementById('upViewInfo').style.display     = 'block';
                document.getElementById('upCloseBtn').style.display      = 'block';
                const btn = document.getElementById('upBtnActualizarAhora');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Actualizar Ahora'; }
            }
        } catch(e) {}
    }

    // Cancelar la descarga
    window.gymCancelarActualizacion = async function() {
        try {
            await fetch('/Home/CancelarActualizacion', { method: 'POST' });
        } catch(e) {}
    };

    // Ping para reconectar cuando el servidor se reinicia
    function iniciarPingReconexion() {
        let intentos = 0;
        pingInterval = setInterval(async function(){
            intentos++;
            try {
                const res = await fetch('/Home/Ping?t=' + Date.now(), { cache: 'no-store' });
                if (res.ok) {
                    clearInterval(pingInterval);
                    // Servidor activo: recargar pantalla tras 1 segundo
                    setTimeout(function(){
                        window.location.reload();
                    }, 1000);
                }
            } catch(e) {
                // El servidor se está reiniciando, reintentará en el siguiente ciclo
            }
            if (intentos > 40) {
                // Timeout preventivo después de 60 segundos
                clearInterval(pingInterval);
                window.location.reload();
            }
        }, 1500);
    }
})();
</script>
}
}
}
    <script>
        window.GYM_CONFIG = {
            nombre: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.GymNombre)),
            domicilio: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.GymDomicilio)),
            telefono: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.GymTelefono)),
            pais: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.Pais)),
            monedaSimbolo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.MonedaSimbolo)),
            monedaCodigo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.MonedaCodigo)),
            lada: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(GymWeb.Helpers.AppSettings.Lada))
        };
        window._gymConfig = window.GYM_CONFIG;
        window.MONEDA_SIMBOLO = window.GYM_CONFIG.monedaSimbolo || '$';
        window.formatearMoneda = function(val) {
            const s = window.MONEDA_SIMBOLO;
            const n = Number(val || 0);
            return `${s}${n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}`;
        };
    </script>
    <script src="~/lib/JsBarcode.all.min.js" asp-append-version="true"></script>
    <script src="~/lib/html2canvas.min.js" asp-append-version="true"></script>
    <script src="~/lib/jspdf.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/gym-tickets-whatsapp.js" asp-append-version="true"></script>
    <script src="~/js/live-sync.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
