<script>
// ── FILTROS Y BÚSQUEDA DE SOCIOS EN VIVO ─────────────────────────────
let filtroActivo = 'todos';

function filtrarSocios(tipo, btn) {
    filtroActivo = tipo;
    document.querySelectorAll('.filtro-btn').forEach(b => {
        b.classList.remove('active');
        b.style.opacity = '0.7';
    });
    if (btn) {
        btn.classList.add('active');
        btn.style.opacity = '1';
    }
    ejecutarBusquedaYFiltro();
}

function ejecutarBusquedaYFiltro() {
    const q = (document.getElementById('tableSearch')?.value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('#tablaSocios tbody tr.socio-row');
    let visibles = 0;

    rows.forEach(r => {
        const estado = r.getAttribute('data-estado');
        const esDeudor = r.getAttribute('data-deudor') === 'true';
        const searchData = r.getAttribute('data-search') || '';

        // Condición de pestaña/filtro
        let coincideFiltro = true;
        if (filtroActivo === 'activos' && estado !== 'activo') coincideFiltro = false;
        if (filtroActivo === 'inactivos' && estado !== 'inactivo') coincideFiltro = false;
        if (filtroActivo === 'deudores' && !esDeudor) coincideFiltro = false;

        // Condición de texto
        let coincideTexto = true;
        if (q.length > 0 && !searchData.includes(q)) {
            coincideTexto = false;
        }

        if (coincideFiltro && coincideTexto) {
            r.style.display = '';
            visibles++;
        } else {
            r.style.display = 'none';
        }
    });

    const lbl = document.getElementById('labelContadorSocios');
    if (lbl) {
        lbl.textContent = `Mostrando ${visibles} socios`;
    }
}

// ── CONTROLADOR DE ASISTENCIAS DEL SOCIO ─────────────────────────────
let asisSocioIdActivo = null;
let asisPeriodoActual = 'semana';

function abrirModalAsistencias(idSocio, nombreSocio) {
    asisSocioIdActivo = idSocio;
    document.getElementById('asisSocioNombre').textContent = `${nombreSocio} (Clave #${idSocio})`;
    document.getElementById('modalAsistencias').style.display = 'flex';
    cambiarPeriodoAsistencias('semana');
}

function cerrarModalAsistencias() {
    document.getElementById('modalAsistencias').style.display = 'none';
    asisSocioIdActivo = null;
}

function cambiarPeriodoAsistencias(periodo) {
    asisPeriodoActual = periodo;
    const btnSemana = document.getElementById('btnAsisSemana');
    const btnMes = document.getElementById('btnAsisMes');
    const btnCustom = document.getElementById('btnAsisCustom');
    const wrapCustom = document.getElementById('wrapAsisFechasCustom');

    [btnSemana, btnMes, btnCustom].forEach(b => {
        b.style.background = 'transparent';
        b.style.color = 'var(--text-muted)';
        b.style.borderColor = 'var(--border)';
    });

    if (periodo === 'semana') {
        btnSemana.style.background = 'rgba(56,189,248,0.15)';
        btnSemana.style.color = '#38bdf8';
        btnSemana.style.borderColor = 'rgba(56,189,248,0.4)';
        wrapCustom.style.display = 'none';
        cargarAsistencias('semana');
    } else if (periodo === 'mes') {
        btnMes.style.background = 'rgba(56,189,248,0.15)';
        btnMes.style.color = '#38bdf8';
        btnMes.style.borderColor = 'rgba(56,189,248,0.4)';
        wrapCustom.style.display = 'none';
        cargarAsistencias('mes');
    } else if (periodo === 'custom') {
        btnCustom.style.background = 'rgba(56,189,248,0.15)';
        btnCustom.style.color = '#38bdf8';
        btnCustom.style.borderColor = 'rgba(56,189,248,0.4)';
        wrapCustom.style.display = 'flex';
        // Inicializar fechas hoy / mes actual si vacías
        const fH = new Date().toISOString().split('T')[0];
        const fD = new Date(Date.now() - 30 * 24 * 3600 * 1000).toISOString().split('T')[0];
        if (!document.getElementById('asisFechaDesde').value) document.getElementById('asisFechaDesde').value = fD;
        if (!document.getElementById('asisFechaHasta').value) document.getElementById('asisFechaHasta').value = fH;
        cargarAsistencias('custom');
    }
}

async function cargarAsistencias(periodo) {
    if (!asisSocioIdActivo) return;

    const loading = document.getElementById('asisLoading');
    const tabla = document.getElementById('tablaAsistenciasDetalle');
    const sinDatos = document.getElementById('asisSinDatos');
    const tbody = document.getElementById('asisTbody');
    const btnExcel = document.getElementById('btnDescargarAsisExcel');

    loading.style.display = 'block';
    tabla.style.display = 'none';
    sinDatos.style.display = 'none';
    tbody.innerHTML = '';

    let url = `/Socios/GetAsistencias?id=${asisSocioIdActivo}&periodo=${periodo}`;
    let excelUrl = `/Socios/ExportarAsistenciasSocio?id=${asisSocioIdActivo}&periodo=${periodo}`;

    if (periodo === 'custom') {
        const d = document.getElementById('asisFechaDesde').value;
        const h = document.getElementById('asisFechaHasta').value;
        if (d && h) {
            url += `&desde=${d}&hasta=${h}`;
            excelUrl += `&desde=${d}&hasta=${h}`;
        }
    }

    btnExcel.href = excelUrl;

    try {
        const resp = await fetch(url);
        const data = await resp.json();
        loading.style.display = 'none';

        if (!data.ok) {
            alert('Error al consultar asistencias: ' + data.msg);
            return;
        }

        const listaAsistencias = data.asistencias || data.items || [];
        const textoPeriodo = data.periodoTexto || data.periodoDisplay || '—';
        const totalDias = (data.total !== undefined ? data.total : (data.diasUnicos !== undefined ? data.diasUnicos : (data.totalAsistencias !== undefined ? data.totalAsistencias : listaAsistencias.length)));

        document.getElementById('asisPeriodoTexto').textContent = textoPeriodo;
        document.getElementById('asisTotalDias').textContent = totalDias;

        if (listaAsistencias.length === 0) {
            sinDatos.style.display = 'block';
            return;
        }

        tabla.style.display = 'table';
        let count = 0;
        listaAsistencias.forEach(item => {
            count++;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td style="text-align:center;color:var(--text-muted);font-size:12px;">${count}</td>
                <td style="font-weight:600;">${item.fecha}</td>
                <td style="text-transform:capitalize;color:var(--text-muted);">${item.dia || item.diaSemana || '—'}</td>
                <td style="text-align:right;color:#38bdf8;font-weight:700;font-family:'Inter',monospace;">${item.hora}</td>
            `;
            tbody.appendChild(tr);
        });

    } catch (e) {
        loading.style.display = 'none';
        alert('Error de conexión al cargar asistencias.');
    }
}

// ── CONTROLADOR DE ESTADO DE CUENTA, FIADOS Y ABONOS ────────────────
let ctaSocioIdActivo = null;
let ctaSaldoTotalPendiente = 0;

function abrirModalEstadoCuenta(idSocio, nombreSocio) {
    ctaSocioIdActivo = idSocio;
    document.getElementById('ctaNombreSocio').textContent = `${nombreSocio} (Clave #${idSocio})`;
    document.getElementById('modalEstadoCuenta').style.display = 'flex';
    toggleFormAbono(false);
    cargarEstadoCuenta();
}

function cerrarModalEstadoCuenta() {
    document.getElementById('modalEstadoCuenta').style.display = 'none';
    ctaSocioIdActivo = null;
}

async function cargarEstadoCuenta() {
    if (!ctaSocioIdActivo) return;

    try {
        const resp = await fetch(`/Socios/GetEstadoCuenta?id=${ctaSocioIdActivo}`);
        const data = await resp.json();

        if (!data.ok) {
            alert('Error al cargar estado de cuenta: ' + data.msg);
            return;
        }

        const totDeuda = Number(data.deudaTotal ?? data.totalDeuda ?? 0);
        const deuProd  = Number(data.deudaProductos ?? 0);
        const deuMem   = Number(data.deudaMembresias ?? 0);

        ctaSaldoTotalPendiente = totDeuda;
        document.getElementById('ctaTotalDeuda').textContent = `$${totDeuda.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        document.getElementById('ctaDeudaProductos').textContent = `$${deuProd.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        document.getElementById('ctaDeudaMembresias').textContent = `$${deuMem.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        // Render productos fiados
        const tbodyProd = document.getElementById('ctaTbodyProductos');
        const sinProd = document.getElementById('ctaSinProductos');
        tbodyProd.innerHTML = '';

        if (!data.productosFiados || data.productosFiados.length === 0) {
            tbodyProd.closest('.table-responsive').style.display = 'none';
            sinProd.style.display = 'block';
        } else {
            tbodyProd.closest('.table-responsive').style.display = 'block';
            sinProd.style.display = 'none';
            data.productosFiados.forEach(p => {
                const totNota = Number(p.totalNota || p.total || 0).toFixed(2);
                const salPend = Number(p.saldoPendiente || 0).toFixed(2);
                const itemsTexto = typeof p.items === 'string' ? p.items : (Array.isArray(p.items) ? p.items.map(i => i.nombre || 'Producto').join(', ') : 'Productos varios');

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-muted" style="white-space:nowrap;">${p.fecha || '—'}</td>
                    <td style="font-weight:600;">${itemsTexto}</td>
                    <td style="text-align:right;">$${totNota}</td>
                    <td style="text-align:right;color:#fb923c;font-weight:700;">$${salPend}</td>
                `;
                tbodyProd.appendChild(tr);
            });
        }

        // Render membresías
        const tbodyMem = document.getElementById('ctaTbodyMembresias');
        const sinMem = document.getElementById('ctaSinMembresias');
        tbodyMem.innerHTML = '';

        const listaMembresias = data.membresiasAdeudadas || data.membresias || [];
        if (listaMembresias.length === 0) {
            tbodyMem.closest('.table-responsive').style.display = 'none';
            sinMem.style.display = 'block';
        } else {
            tbodyMem.closest('.table-responsive').style.display = 'block';
            sinMem.style.display = 'none';
            listaMembresias.forEach(m => {
                const mPrecio = Number(m.precio || 0).toFixed(2);
                const mPagado = Number(m.pagado || 0).toFixed(2);
                const mPend = Number(m.pendiente != null ? m.pendiente : m.precio || 0).toFixed(2);

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight:600;">${m.nombre || 'Membresía'}</td>
                    <td class="text-muted">${m.vigencia || m.fechaInicio || '—'}</td>
                    <td style="text-align:right;">$${mPrecio}</td>
                    <td style="text-align:right;color:#4ade80;">$${mPagado}</td>
                    <td style="text-align:right;color:#38bdf8;font-weight:700;">$${mPend}</td>
                `;
                tbodyMem.appendChild(tr);
            });
        }

    } catch (e) {
        console.error('Error al cargar estado de cuenta:', e);
        alert('Error al consultar el estado de cuenta: ' + (e.message || e));
    }
}

function toggleFormAbono(forzar) {
    const wrap = document.getElementById('wrapFormAbono');
    const err = document.getElementById('abonoError');
    err.style.display = 'none';
    if (forzar !== undefined) {
        wrap.style.display = forzar ? 'block' : 'none';
    } else {
        wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
    }
    if (wrap.style.display === 'block') {
        const inp = document.getElementById('abonoMonto');
        inp.value = ctaSaldoTotalPendiente > 0 ? ctaSaldoTotalPendiente.toFixed(2) : '';
        inp.focus();
    }
}

function llenarMontoTotalAbonar() {
    if (ctaSaldoTotalPendiente > 0) {
        document.getElementById('abonoMonto').value = ctaSaldoTotalPendiente.toFixed(2);
    }
}

async function procesarAbono() {
    if (!ctaSocioIdActivo) return;

    const montoVal = parseFloat(document.getElementById('abonoMonto').value);
    const metodo = document.getElementById('abonoMetodo').value;
    const notas = document.getElementById('abonoNotas').value;
    const btn = document.getElementById('btnConfirmarAbono');
    const err = document.getElementById('abonoError');

    err.style.display = 'none';

    if (isNaN(montoVal) || montoVal <= 0) {
        err.textContent = 'Ingresa un monto válido mayor a $0.00';
        err.style.display = 'block';
        return;
    }

    if (montoVal > ctaSaldoTotalPendiente + 0.01) {
        if (!confirm(`El monto ingresado ($${montoVal.toFixed(2)}) supera el saldo total adeudado ($${ctaSaldoTotalPendiente.toFixed(2)}). ¿Deseas cobrar este monto de todos modos?`)) {
            return;
        }
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Registrando abono...';

    try {
        const resp = await fetch('/Socios/RegistrarAbono', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({
                idSocio: ctaSocioIdActivo,
                monto: montoVal,
                metodoPago: metodo,
                notas: notas
            })
        });

        const data = await resp.json();
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar Cobro e Ingresar a Caja';

        if (!data.ok) {
            err.textContent = data.msg;
            err.style.display = 'block';
            return;
        }

        toggleFormAbono(false);
        await cargarEstadoCuenta();

        if (data.pagoId) {
            window.abrirModalPostAbono(data.pagoId, data.msg);
        } else {
            alert('✓ ' + data.msg);
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        }

    } catch (e) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar Cobro e Ingresar a Caja';
        err.textContent = 'Error de conexión al procesar el abono.';
        err.style.display = 'block';
    }
}

async function imprimirComprobanteAbono(idPago) {
    try {
        const resp = await fetch(`/Pagos/GetDetallePago?idPago=${idPago}`);
        const data = await resp.json();
        if (!data.ok) return;

        const folio = data.folio || ('#PAG-' + idPago);
        const fecha = data.fecha || new Date().toLocaleString();
        const socio = data.socio || 'Socio';
        const socioClave = data.socioId ? '#' + data.socioId : '';
        const plan = data.plan || 'Abono / Pago de Deuda';
        const metodo = data.metodoPago || 'Efectivo';
        const cajero = data.cajero || 'Recepción';
        const notas = data.notas || '';
        const monto = Number(data.monto || 0).toFixed(2);
        const gymNom = data.gymNombre || 'MI GIMNASIO';
        const gymDom = data.gymDomicilio || '';
        const gymTel = data.gymTelefono || '';
        const pie    = data.gymPieTicket || '¡Gracias por su pago!';

        const barcodeHtml = window.generarBarcodeSvgDirecto ? window.generarBarcodeSvgDirecto(folio, folio + (socioClave ? ' | ' + socioClave : '')) : '';

        const html = `<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Comprobante ${folio}</title>
    <style>
        @@page { size: auto; margin: 0 0 8mm 0; }
        * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        html, body { margin: 0; padding: 0; width: 100%; background: #fff; color: #000; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; font-size: 11.5px; line-height: 1.3; }
        .ticket-wrapper { width: 100%; max-width: 72mm; margin: 0 auto; padding: 2mm 2.5mm 12mm 2.5mm; page-break-inside: avoid; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .fw-bold { font-weight: 700; }
        .fw-black { font-weight: 900; }
        .logo-wrap { text-align: center; margin-bottom: 4px; }
        .logo-img { max-width: 120px; max-height: 50px; object-fit: contain; filter: grayscale(100%); margin: 0 auto; display: block; }
        .gym-name { font-size: 14px; font-weight: 800; text-transform: uppercase; margin: 2px 0 3px 0; line-height: 1.2; color: #000; }
        .gym-info { font-size: 10.5px; color: #000; margin-bottom: 2px; }
        .receipt-badge { display: inline-block; font-size: 11px; font-weight: 800; border: 1.5px solid #000; padding: 1.5px 8px; border-radius: 3px; text-transform: uppercase; margin: 4px 0 2px 0; color: #000; }
        .divider { border-top: 1px dashed #000; margin: 5px 0; width: 100%; }
        .meta-table, .totals-table { width: 100%; border-collapse: collapse; font-size: 11px; color: #000; }
        .meta-table td { padding: 1.5px 0; vertical-align: top; }
        .meta-label { font-weight: 600; color: #000; width: 32%; }
        .meta-val { font-weight: 700; color: #000; text-align: right; word-break: break-word; }
        .total-big { font-size: 15px; font-weight: 900; border-top: 1.5px dashed #000; border-bottom: 1.5px dashed #000; padding: 4px 0 !important; color: #000; }
        .footer-note { margin-top: 7px; text-align: center; color: #000; }
        .footer-note .pie-msg { font-size: 11px; font-weight: 700; line-height: 1.25; margin-bottom: 2px; }
        .footer-note .pie-sub { font-size: 9.5px; font-weight: 600; }
    </style>
</head>
<body>
    <div class="ticket-wrapper">
        <div class="logo-wrap">
            <img class="logo-img" src="/img/logo-custom.png?v=${Date.now()}" onerror="this.style.display='none'" />
        </div>
        <div class="text-center">
            <div class="gym-name">${gymNom}</div>
            ${gymDom ? `<div class="gym-info">${gymDom}</div>` : ''}
            ${gymTel ? `<div class="gym-info">Tel / WhatsApp: ${gymTel}</div>` : ''}
            <div class="receipt-badge">COMPROBANTE DE ABONO</div>
        </div>
        <div class="divider"></div>
        <table class="meta-table">
            <tr><td class="meta-label">FOLIO:</td><td class="meta-val">${folio}</td></tr>
            <tr><td class="meta-label">FECHA:</td><td class="meta-val">${fecha}</td></tr>
            <tr><td class="meta-label">SOCIO:</td><td class="meta-val">${socio} ${socioClave}</td></tr>
            <tr><td class="meta-label">CONCEPTO:</td><td class="meta-val">${plan}</td></tr>
            <tr><td class="meta-label">MÉTODO:</td><td class="meta-val">${metodo}</td></tr>
            <tr><td class="meta-label">ATENDIÓ:</td><td class="meta-val">${cajero}</td></tr>
            ${notas ? `<tr><td class="meta-label">NOTAS:</td><td class="meta-val">${notas}</td></tr>` : ''}
        </table>
        <div class="divider"></div>
        <table class="totals-table">
            <tr class="total-big">
                <td>MONTO ABONADO:</td>
                <td class="text-right">$${monto}</td>
            </tr>
        </table>
        ${barcodeHtml}
        <div class="footer-note">
            <div class="pie-msg">${pie}</div>
            <div class="pie-sub">Conserve este comprobante para cualquier aclaración</div>
        </div>
    </div>
    <script>
        window.onload = function() {
            setTimeout(function() { window.focus(); window.print(); }, 200);
        };
    <\/script>
</body>
</html>`;

        if (window.GymPrintManager && typeof window.GymPrintManager.ejecutarImpresionNativa === 'function') {
            window.GymPrintManager.ejecutarImpresionNativa(html);
        } else {
            let iframe = document.getElementById('iframePrintAbono');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'iframePrintAbono';
                iframe.style.position = 'fixed';
                iframe.style.top = '-9999px';
                iframe.style.left = '-9999px';
                iframe.style.width = '0px';
                iframe.style.height = '0px';
                iframe.style.border = 'none';
                document.body.appendChild(iframe);
            }
            const doc = iframe.contentWindow || iframe.contentDocument;
            if (doc.document) {
                const d = doc.document;
                d.open(); d.write(html); d.close();
            } else {
                doc.open(); doc.write(html); doc.close();
            }
        }
    } catch (e) {
        console.error('Error al imprimir comprobante:', e);
    }
}

async function enviarTicketAbonoWhatsApp(idPago) {
    try {
        const resp = await fetch(`/Pagos/GetDetallePago?idPago=${idPago}`);
        const data = await resp.json();
        if (data.ok) {
            data.tipoTicket = 'ABONO';
            window.abrirModalWhatsAppTicket(data);
        } else {
            alert(data.msg || 'No se pudo obtener la información para WhatsApp.');
        }
    } catch (e) {
        alert('Error de conexión al preparar comprobante de WhatsApp.');
    }
}
</script>
