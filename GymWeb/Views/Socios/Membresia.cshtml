@model IEnumerable<GymWeb.Models.Vwsociomembresia>
@{
    var socio = ViewBag.Socio as GymWeb.Models.Socio;
    var membresias = ViewBag.Membresias as IEnumerable<GymWeb.Models.Membresium>;
    var actual = Model.OrderByDescending(v => v.FechaCreacion).FirstOrDefault(v => v.IdEstado == 1);
    bool vencida = actual != null && actual.Vencimiento.HasValue && actual.Vencimiento.Value < DateTime.Today;
    DateTime fechaSugerida = (actual != null && actual.Vencimiento.HasValue && actual.Vencimiento.Value >= DateTime.Today)
        ? actual.Vencimiento.Value.AddDays(1)
        : DateTime.Today;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert" style="background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.35);color:#fbbf24;padding:12px 16px;border-radius:8px;margin-bottom:16px;">
        <i class="fa-solid fa-triangle-exclamation"></i> @TempData["Warning"]
    </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;">
    <!-- Assign / Renew membership -->
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                @if (vencida)
                {
                    <i class="fa-solid fa-rotate" style="color:#f87171;"></i>
                    <span style="color:#f87171;">@socio?.Nombre @socio?.Paterno — Renovar Membresía</span>
                }
                else if (!Model.Any())
                {
                    <i class="fa-solid fa-id-card"></i>
                    <span>@socio?.Nombre @socio?.Paterno — Asignar Membresía</span>
                }
                else
                {
                    <i class="fa-solid fa-id-card"></i>
                    <span>@socio?.Nombre @socio?.Paterno — Nueva Membresía</span>
                }
            </div>
            <a asp-action="Index" class="btn btn-outline btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
        </div>

        @if (vencida)
        {
            <div class="alert alert-danger" style="margin-bottom:16px;">
                <i class="fa-solid fa-triangle-exclamation"></i>
                La membresía <strong>@actual!.NombreMembresia</strong> venció el <strong>@actual.Vencimiento?.ToString("dd/MM/yyyy")</strong>.
                Selecciona una nueva membresía para renovar.
            </div>
        }
        else if (actual != null)
        {
            <div class="alert alert-success" style="margin-bottom:16px;font-size:13px;">
                <i class="fa-solid fa-circle-check"></i>
                Membresía activa: <strong>@actual.NombreMembresia</strong> — vence el <strong>@actual.Vencimiento?.ToString("dd/MM/yyyy")</strong>.
                Puedes asignar una nueva para cuando concluya.
            </div>
        }

        <form asp-action="AsignarMembresia" method="post" id="formAsignarMembresia">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idSocio" value="@socio?.IdSocio" />
            <div class="form-grid">
                <div class="form-group" style="grid-column:1/-1;">
                    <label class="form-label">Membresía <span style="color:#f87171;">*</span></label>
                    <select name="idMembresia" id="selMembresia" class="form-select" required onchange="onMembresiaChange(this)">
                        <option value="">Seleccionar...</option>
                        @foreach (var m in membresias ?? Enumerable.Empty<GymWeb.Models.Membresium>())
                        {
                            string durLabel = m.Meses switch {
                                1 => "1 día",
                                7 => "7 días (1 semana)",
                                15 => "15 días (quincena)",
                                30 => "1 mes (30 días)",
                                var x when x.HasValue && x.Value >= 60 && x.Value % 30 == 0 => $"{x.Value / 30} meses",
                                var x when x.HasValue => $"{x.Value} días",
                                _ => "Personalizada"
                            };
                            <option value="@m.IdMembresia" data-precio="@(m.Precio ?? 0)">@m.Nombre — @durLabel — $@m.Precio</option>
                        }
                    </select>
                </div>
                <div class="form-group" style="grid-column:1/-1;">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" name="fechaInicio" class="form-control"
                           value="@fechaSugerida.ToString("yyyy-MM-dd")" required />
                </div>

                <!-- Opciones de Cobro de Contado vs Adeudo -->
                <div class="form-group" style="grid-column:1/-1;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);padding:14px;border-radius:10px;margin-top:6px;">
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin-bottom:10px;">
                        <input type="checkbox" name="registrarPago" id="chkRegistrarPago" value="true" checked onchange="toggleCobroMembresia(this.checked)" style="width:18px;height:18px;accent-color:#00e5ff;" />
                        <span style="font-weight:700;color:#00e5ff;font-size:13.5px;"><i class="fa-solid fa-cash-register"></i> Registrar cobro e ingresar a caja de inmediato</span>
                    </label>

                    <div id="seccionCamposCobro" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px;">
                        <div>
                            <label class="form-label" style="font-size:12px;">Monto a Cobrar ($MXN)</label>
                            <input type="number" name="montoPago" id="inputMontoPago" class="form-control" step="0.01" min="0.01" placeholder="0.00" />
                        </div>
                        <div>
                            <label class="form-label" style="font-size:12px;">Método de Pago</label>
                            <select name="metodoPago" class="form-select">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta">Tarjeta</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                        </div>
                    </div>

                    <div id="avisoCobroPendiente" style="display:none;margin-top:6px;font-size:12px;color:#f87171;background:rgba(239,68,68,0.1);padding:8px 12px;border-radius:6px;border:1px solid rgba(239,68,68,0.2);">
                        <i class="fa-solid fa-triangle-exclamation"></i> <strong>Atención:</strong> La membresía se activará pero quedará registrada como <strong>adeudo pendiente</strong> en el estado de cuenta del socio.
                    </div>
                </div>
            </div>
            <div style="margin-top:16px;">
                <button type="submit" class="btn @(vencida ? "btn-danger" : "btn-primary")">
                    <i class="fa-solid @(vencida ? "fa-rotate" : "fa-plus")"></i>
                    @(vencida ? "Renovar Membresía" : "Asignar Membresía")
                </button>
            </div>
        </form>

        <script>
            function onMembresiaChange(sel) {
                const opt = sel.options[sel.selectedIndex];
                const precio = opt ? opt.dataset.precio : '';
                const inputMonto = document.getElementById('inputMontoPago');
                if (inputMonto && precio) {
                    inputMonto.value = parseFloat(precio).toFixed(2);
                }
            }

            function toggleCobroMembresia(checked) {
                const campos = document.getElementById('seccionCamposCobro');
                const aviso = document.getElementById('avisoCobroPendiente');
                if (campos) campos.style.display = checked ? 'grid' : 'none';
                if (aviso) aviso.style.display = checked ? 'none' : 'block';
            }
        </script>
    </div>

    <!-- History -->
    <div class="card">
        <div class="card-header">
            <div class="card-title"><i class="fa-solid fa-clock-rotate-left"></i> Historial</div>
        </div>
        @if (!Model.Any())
        {
            <p class="text-muted" style="font-size:13px;padding:8px 0;">Sin membresías registradas.</p>
        }
        else
        {
            <table class="gym-table">
                <thead>
                    <tr>
                        <th>Membresía</th>
                        <th>Inicio</th>
                        <th>Vencimiento</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var v in Model)
                {
                    bool esVencida = v.IdEstado == 1 && v.Vencimiento.HasValue && v.Vencimiento.Value < DateTime.Today;
                    <tr>
                        <td style="font-size:13px;">@(v.NombreMembresia ?? $"Mem. #{v.IdMembresia}")</td>
                        <td style="font-size:12px;" class="text-muted">@v.FechaInicioMembresia?.ToString("dd/MM/yy")</td>
                        <td style="font-size:12px;" class="@(esVencida ? "" : "text-muted")">
                            @if (v.Vencimiento.HasValue)
                            {
                                if (esVencida)
                                { <span style="color:#f87171;font-weight:600;">@v.Vencimiento.Value.ToString("dd/MM/yy")</span> }
                                else
                                { <span>@v.Vencimiento.Value.ToString("dd/MM/yy")</span> }
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>
                            @if (esVencida)
                            { <span class="badge badge-danger"><i class="fa-solid fa-clock"></i> Vencida</span> }
                            else if (v.IdEstado == 1)
                            { <span class="badge badge-success">Activa</span> }
                            else
                            { <span class="badge" style="background:rgba(255,255,255,0.07);color:#8b8fa8;">Inactiva</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
