                Conéctate desde cualquier <strong>celular, tablet u otra computadora</strong> conectada a tu misma red Wi-Fi para consultar reportes, registrar visitas o realizar cobros en tiempo real directamente sobre esta PC principal.
            </p>

            <!-- CAJA PRINCIPAL: QR Y DIRECCIÓN -->
            <div class="redlan-hero-grid" style="display:grid;grid-template-columns:auto 1fr;gap:26px;background:linear-gradient(145deg, rgba(15,23,42,0.85), rgba(30,41,59,0.5));border:1px solid rgba(0,242,100,0.25);border-radius:16px;padding:24px;align-items:center;margin-bottom:22px;">
                <!-- QR CODE -->
                <div style="text-align:center;display:flex;flex-direction:column;align-items:center;">
                    <div style="background:#ffffff;padding:12px;border-radius:14px;box-shadow:0 10px 28px rgba(0,0,0,0.45);display:inline-block;border:2px solid rgba(0,242,100,0.35);">
                        <div id="redlanQrContainer" style="width:170px;height:170px;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden;">
                            <!-- QR se genera dinámicamente -->
                        </div>
                    </div>
                    <span style="color:#94a3b8;font-size:11.5px;margin-top:10px;display:inline-flex;align-items:center;gap:6px;font-weight:500;">
                        <i class="fa-solid fa-camera" style="color:#00f264;"></i> Escanea con la cámara del celular
                    </span>
                </div>

                <!-- DETALLES Y ENLACE -->
                <div>
                    <label class="form-label" style="font-size:12px;text-transform:uppercase;letter-spacing:0.8px;color:#94a3b8;margin-bottom:8px;display:block;font-weight:700;">
                        Dirección de Acceso en tu Red:
                    </label>

                    @if (redLan.Adaptadores.Count > 1)
                    {
                        <div style="margin-bottom:12px;">
                            <label style="font-size:11.5px;color:#64748b;margin-bottom:4px;display:block;font-weight:600;">Adaptador de Red:</label>
                            <select id="selectInterfazRed" class="form-control" style="font-size:12.5px;padding:7px 12px;height:auto;background:rgba(15,23,42,0.9);border-color:rgba(255,255,255,0.18);color:#f8fafc;" onchange="cambiarInterfazRed(this.value)">
                                @foreach (var iface in redLan.Adaptadores)
                                {
                                    <option value="@iface.IpAddress" selected="@(iface.IpAddress == redLan.IpPrincipal ? "selected" : null)">
                                        @iface.Name (@iface.IpAddress)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div style="margin-bottom:14px;">
                        <input id="inputUrlRedLan" readonly value="@redLan.UrlCompleta" class="form-control" style="font-family:'Consolas', 'Courier New', monospace;font-size:15px;font-weight:800;letter-spacing:0.5px;color:#00f264;background:rgba(10,15,29,0.95);border:1.5px solid rgba(0,242,100,0.45);padding:11px 16px;border-radius:10px;width:100%;box-shadow:inset 0 2px 4px rgba(0,0,0,0.4);" />
                    </div>

                    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
                        <button type="button" class="btn btn-primary" onclick="copiarUrlRedLan()" style="background:#00f264;color:#052e16;font-weight:800;display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border-radius:10px;border:none;box-shadow:0 4px 14px rgba(0,242,100,0.25);cursor:pointer;">
                            <i class="fa-solid fa-copy"></i> Copiar Enlace
                        </button>
                        <a id="btnAbrirRedLan" href="@redLan.UrlCompleta" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:10px;font-weight:600;text-decoration:none;">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir en Navegador
                        </a>
                        <button type="button" class="btn btn-secondary" onclick="refrescarIpRedLan()" title="Escanear adaptadores de red nuevamente" style="padding:9px 14px;border-radius:10px;" id="btnRefreshRedLan">
                            <i class="fa-solid fa-arrows-rotate" id="iconRefreshRedLan"></i> Actualizar IP
                        </button>
                    </div>

                    <div style="margin-top:14px;font-size:12px;color:#94a3b8;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,0.02);padding:8px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.05);">
                        <i class="fa-solid fa-circle-check" style="color:#00f264;font-size:14px;"></i>
                        <span>Sincronización en tiempo real: cualquier cambio en el celular se refleja al instante en esta PC.</span>
                    </div>
                </div>
            </div>

            <!-- GUÍA PWA: AGREGAR COMO APP -->
            <div style="margin-top:20px;">
                <h4 style="font-size:13.5px;font-weight:700;color:#f8fafc;margin:0 0 12px 0;display:flex;align-items:center;gap:8px;">
                    <i class="fa-solid fa-mobile-screen-button" style="color:#00f264;"></i> ¿Cómo guardarlo como Aplicación en la pantalla de inicio de tu celular?
                </h4>
                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:14px;">
                    <!-- ANDROID -->
                    <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                            <div style="width:28px;height:28px;border-radius:7px;background:rgba(34,197,94,0.15);color:#22c55e;display:flex;align-items:center;justify-content:center;font-size:14px;">
                                <i class="fa-brands fa-android"></i>
                            </div>
                            <strong style="color:#f8fafc;font-size:13px;">En Android (Google Chrome)</strong>
                        </div>
                        <ol style="margin:0;padding-left:18px;color:#cbd5e1;font-size:12px;line-height:1.65;">
                            <li>Abre el enlace o escanea el QR desde tu celular.</li>
                            <li>Toca los tres puntos <strong style="color:#fff;">(⋮)</strong> arriba a la derecha en Chrome.</li>
                            <li>Elige <strong style="color:#00f264;">"Agregar a la pantalla principal"</strong> o <strong style="color:#00f264;">"Instalar aplicación"</strong>.</li>
                        </ol>
                    </div>

                    <!-- IPHONE / IPAD -->
                    <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:16px;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                            <div style="width:28px;height:28px;border-radius:7px;background:rgba(56,189,248,0.15);color:#38bdf8;display:flex;align-items:center;justify-content:center;font-size:14px;">
                                <i class="fa-brands fa-apple"></i>
                            </div>
                            <strong style="color:#f8fafc;font-size:13px;">En iPhone / iPad (Safari)</strong>
                        </div>
                        <ol style="margin:0;padding-left:18px;color:#cbd5e1;font-size:12px;line-height:1.65;">
                            <li>Abre el enlace escaneado en el navegador <strong style="color:#fff;">Safari</strong>.</li>
                            <li>Toca el botón <strong style="color:#38bdf8;">Compartir</strong> (ícono cuadrado con flecha arriba).</li>
                            <li>Baja y presiona <strong style="color:#38bdf8;">"Agregar al inicio"</strong>.</li>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- NOTA SOBRE FIREWALL / RED -->
            <div style="margin-top:16px;background:rgba(234,179,8,0.08);border:1px solid rgba(234,179,8,0.25);border-radius:12px;padding:14px 16px;display:flex;gap:12px;align-items:flex-start;">
                <div style="color:#eab308;font-size:18px;line-height:1;margin-top:2px;flex-shrink:0;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div style="font-size:12.5px;color:#cbd5e1;line-height:1.5;">
                    <strong style="color:#fde047;">Requisito indispensable:</strong> Ambos dispositivos deben estar conectados a la misma red Wi-Fi. Si desde tu teléfono no carga la página, abre la carpeta del sistema y ejecuta <code>Habilitar_Red_LAN.bat</code> como administrador para autorizar el puerto 5080 en el Firewall de Windows en 1 clic.
                </div>
            </div>
        </div>
    </div>
</div>

