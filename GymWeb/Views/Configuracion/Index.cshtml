    function alCambiarPais(paisKey) {
        paisKey = (paisKey || '').toUpperCase();
        const data = DATOS_PAISES[paisKey];
        if (!data) return;

        const inputSimbolo = document.getElementById('inputMonedaSimbolo');
        const inputCodigo = document.getElementById('inputMonedaCodigo');
        const inputLada = document.getElementById('inputLada');

        if (inputSimbolo) inputSimbolo.value = data.simbolo;
        if (inputCodigo) inputCodigo.value = data.codigo;
        if (inputLada) inputLada.value = data.lada;

        actualizarPreviewRegion();
    }

    function actualizarPreviewRegion() {
        const paisKey = (document.getElementById('selectPaisConfig')?.value || 'MX').toUpperCase();
        const info = DATOS_PAISES[paisKey];
        const simbolo = document.getElementById('inputMonedaSimbolo')?.value || '$';
        const codigo = document.getElementById('inputMonedaCodigo')?.value || 'MXN';
        const lada = document.getElementById('inputLada')?.value || '52';

        const prevPrecio = document.getElementById('prevPrecioEjemplo');
        if (prevPrecio) {
            prevPrecio.textContent = `${simbolo} 1,500.00 ${codigo}`;
        }

        const prevWhats = document.getElementById('prevWhatsEjemplo');
        if (prevWhats) {
            if (info && info.lada === lada) {
                prevWhats.textContent = info.formatoWhats;
            } else {
                prevWhats.textContent = `+${lada} ...`;
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        actualizarPreviewRegion();
    });
