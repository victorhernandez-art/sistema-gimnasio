<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AssemblyName>DigitalPersonaBridge</AssemblyName>
    <RootNamespace>DigitalPersonaBridge</RootNamespace>
  </PropertyGroup>

  <!-- Si las DLLs de DigitalPersona OneTouch SDK están instaladas en el sistema o en la carpeta lib, se referencian -->
  <ItemGroup>
    <None Include="INICIAR-PUENTE-BIOMETRICO.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
